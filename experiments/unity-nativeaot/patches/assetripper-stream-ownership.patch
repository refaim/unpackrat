+
+	internal SmartStream CreateReadOnlySlice(long offset, long length,
+		Func<SmartStream, object, long, long, Stream> createRange, Func<Stream, SmartStream> createWrapper)
+	{
+		ThrowIfNull();
+		if (offset < 0 || length < 0 || offset > Length || length > Length - offset)
+			throw new ArgumentOutOfRangeException(nameof(length));
+		SmartStream? owned = CreateReference();
+		Stream? range = null;
+		try
+		{
+			range = createRange(owned, RefCounter.Owner, offset, length);
+			SmartStream result = createWrapper(range);
+			owned = null;
+			range = null;
+			return result;
+		}
+		finally
+		{
+			range?.Dispose();
+			owned?.Dispose();
+		}
 	}
 
