+			throw new ArgumentOutOfRangeException(nameof(length));
+		object sourceGate = RefCounter.Owner;
+		SmartStream? owned;
+		if (Stream is OwnedReadOnlyRange parent)
+		{
+			// Descendants lease the captured source/view directly: its RefCount grows while
+			// the parent range's RefCount stays unchanged. Preserve the exact source view and gate.
