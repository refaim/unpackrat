new file mode 100644
--- /dev/null
+++ b/Source/AssetRipper.IO.Files/BundleFiles/FileStream/BundleDataStream.cs
@@ -0,0 +1,89 @@
+using AssetRipper.IO.Files.Streams.Smart;
+
+namespace AssetRipper.IO.Files.BundleFiles.FileStream;
+
+/// <summary>A seekable view of the existing UnityFS block table, with one decompressed block cached.</summary>
+internal sealed class BundleDataStream : Stream
+{
+	private readonly SmartStream source;
+	private readonly BundleFileBlockReader reader;
+	private readonly long[] logicalOffsets;
+	private readonly long[] compressedOffsets;
+	private long position;
+	private bool disposed;
+
+	public BundleDataStream(SmartStream input, BlocksInfo blocks)
+		: this(input, blocks, static (source, metadata) => new BundleFileBlockReader(source, metadata)) { }
+
+	internal BundleDataStream(SmartStream input, BlocksInfo blocks,
+		Func<SmartStream, BlocksInfo, BundleFileBlockReader> createReader)
+	{
+		logicalOffsets = new long[blocks.StorageBlocks.Length + 1];
+		compressedOffsets = new long[blocks.StorageBlocks.Length + 1];
+		for (int i = 0; i < blocks.StorageBlocks.Length; i++)
+		{
+			StorageBlock block = blocks.StorageBlocks[i];
+			logicalOffsets[i + 1] = checked(logicalOffsets[i] + block.UncompressedSize);
+			compressedOffsets[i + 1] = checked(compressedOffsets[i] + block.CompressedSize);
+			if (block.CompressionType == CompressionType.None && block.UncompressedSize != block.CompressedSize)
+				throw new InvalidDataException("An uncompressed block has inconsistent sizes.");
+		}
+		if (compressedOffsets[^1] > input.Length - input.Position)
+			throw new InvalidDataException("Bundle blocks extend beyond the source.");
+		source = input.CreateReadOnlySlice(input.Position, compressedOffsets[^1]);
+		try { reader = createReader(source, blocks); }
+		catch { source.Dispose(); throw; }
+	}
+
+	private void CheckOpen() => ObjectDisposedException.ThrowIf(disposed, this);
+	public override bool CanRead => !disposed;
+	public override bool CanSeek => !disposed;
+	public override bool CanWrite => false;
+	public override long Length { get { CheckOpen(); return logicalOffsets[^1]; } }
+	public override long Position
+	{
+		get { CheckOpen(); return position; }
+		set { CheckOpen(); if (value < 0 || value > Length) throw new ArgumentOutOfRangeException(nameof(value)); position = value; }
+	}
+
+	public override int Read(byte[] buffer, int offset, int count) => Read(buffer.AsSpan(offset, count));
+	public override int Read(Span<byte> buffer)
+	{
+		CheckOpen();
+		int total = 0;
+		while (!buffer.IsEmpty && position < Length)
+		{
+			// Upper bound handles empty blocks and exact block boundaries without a zero-progress loop.
+			int low = 0, high = logicalOffsets.Length - 1;
+			while (low < high)
+			{
+				int middle = low + (high - low) / 2;
+				if (logicalOffsets[middle + 1] <= position) low = middle + 1;
+				else high = middle;
+			}
+			int read = reader.ReadBlockRange(low, compressedOffsets[low], position - logicalOffsets[low], buffer);
+			position += read;
+			total += read;
+			buffer = buffer[read..];
+		}
+		return total;
+	}
+	public override int ReadByte() { Span<byte> one = stackalloc byte[1]; return Read(one) == 0 ? -1 : one[0]; }
+	public override long Seek(long offset, SeekOrigin origin)
+	{
+		long start = origin switch { SeekOrigin.Begin => 0, SeekOrigin.Current => Position, SeekOrigin.End => Length, _ => throw new ArgumentException("Invalid seek origin.", nameof(origin)) };
+		long target;
+		try { target = checked(start + offset); }
