* text eol=crlf
# Port patches must retain LF so Git can parse empty context lines after checkout.
build/vcpkg/ports/**/*.patch text eol=lf
# The Unity ownership patch must retain LF so Git can parse empty context lines after checkout.
experiments/unity-nativeaot/patches/*.patch text eol=lf
# Vendored single-header libraries are pinned by their canonical LF byte digest so the
# working-tree bytes stay byte-identical to the verified upstream blobs.
third_party/**/*.h text eol=lf

# Preserve repository-owned archive fixtures byte for byte across checkouts.
src/tests/data/**/*.pck binary
src/tests/data/**/*.rpa binary
# Unity experiment fixtures are checked out byte for byte; text conversion corrupts them.
experiments/unity-nativeaot/fixtures/audio/*.fsb binary
experiments/unity-nativeaot/fixtures/*.assets binary
# Expected text fixtures retain LF so their checkout bytes match the committed blobs.
experiments/unity-nativeaot/fixtures/*.expected.txt text eol=lf
src/tests/fixtures/**/*.wolf binary
src/tests/fixtures/**/*.bin binary
