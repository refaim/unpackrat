+size_t WolfDec::ModeCount(const CryptModes& additionalModes) noexcept
+{
+	return DEFAULT_CRYPT_MODES.size() + additionalModes.size();
+}
+
+const CryptMode& WolfDec::ModeAt(const CryptModes& additionalModes, const uint32_t& index)
+{
+	return (index < DEFAULT_CRYPT_MODES.size() ? DEFAULT_CRYPT_MODES.at(index) : additionalModes.at(index - DEFAULT_CRYPT_MODES.size()));
+}
+
+bool WolfDec::SelectMode(const CryptModes& additionalModes, const uint16_t& cryptVersion, uint32_t& modeIndex) noexcept
+{
+	if (cryptVersion == 0)
+		return false;
+
+	for (uint32_t i = 0; i < DEFAULT_CRYPT_MODES.size(); i++)
+	{
+		if (DEFAULT_CRYPT_MODES.at(i).cryptVersion == cryptVersion)
+		{
+			modeIndex = i;
+			return true;
+		}
+	}
+
+	for (uint32_t i = 0; i < additionalModes.size(); i++)
+	{
+		if (additionalModes.at(i).cryptVersion == cryptVersion)
+		{
+			modeIndex = static_cast<uint32_t>(DEFAULT_CRYPT_MODES.size() + i);
+			return true;
+		}
+	}
+
+	return false;
+}
+
+bool WolfDec::SelectWorkingMode(const CryptModes& additionalModes, const uint32_t& mode, uint32_t& selectedMode, const ModeAttempt& attempt)
+{
+	if (mode != static_cast<uint32_t>(-1))
+	{
+		if (attempt(mode))
+		{
+			selectedMode = mode;
+			return true;
+		}
+
+		return false;
+	}
+
+	const uint32_t modeCount = static_cast<uint32_t>(ModeCount(additionalModes));
+
+	for (uint32_t i = 0; i < modeCount; i++)
+	{
+		if (attempt(i))
+		{
+			selectedMode = i;
+			return true;
+		}
+	}
+
+	return false;
+}
+
+CryptVersionDecision WolfDec::ClassifyCryptVersion(const uint16_t& cryptVersion) noexcept
+{
+	CryptVersionDecision decision;
+	decision.cryptVersion = cryptVersion;
+
+	if (cryptVersion == 0x0)
+		decision.classification = CryptVersionClass::Trial;
+	else if (cryptVersion >= PRO_CRYPT_VERSION)
+		decision.classification = CryptVersionClass::ProRecovery;
+	else if (cryptVersion == CC2_PRO_VERSION)
+		decision.classification = CryptVersionClass::Cc2Recovery;
+	else
+		decision.classification = CryptVersionClass::ExactMatch;
+
+	return decision;
+}
+
+uint16_t WolfDec::CryptVersionFromHeader(const void* data, const size_t& size) noexcept
+{
+	if (data == nullptr || size < sizeof(DARC_HEAD))
+		return 0;
+
+	DARC_HEAD header;
+	std::memcpy(&header, data, sizeof(DARC_HEAD));
+
+	if (header.Head != DXA_HEAD)
+		return 0;
+
+	return static_cast<uint16_t>(header.Flags >> 16);
+}
