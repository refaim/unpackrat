 {
 public:
@@ -128,6 +156,31 @@ public:
 
 	static const CryptModes& DefaultCryptModes() noexcept;
 
+	// The ordered combined crypt-mode storage: the pinned default modes first, then the
+	// additional modes. This is the single ordering rule the selection and the trial loop use.
+	static size_t ModeCount(const CryptModes& additionalModes) noexcept;
+	static const CryptMode& ModeAt(const CryptModes& additionalModes, const uint32_t& index);
+
+	// The ordered candidate lookup detectCrypt performs: the first default mode whose cryptVersion
+	// equals cryptVersion, otherwise the first additional mode. A zero cryptVersion never matches,
+	// mirroring detectCrypt's nonzero gate, and a miss leaves modeIndex untouched.
+	static bool SelectMode(const CryptModes& additionalModes, const uint16_t& cryptVersion, uint32_t& modeIndex) noexcept;
+
+	// The automatic mode decision UnpackArchive performs for an archive header crypt version.
+	static CryptVersionDecision ClassifyCryptVersion(const uint16_t& cryptVersion) noexcept;
+
+	// Bounded DARC_HEAD interpretation, shared with any stream caller: data must point at size
+	// bytes. Returns Flags >> 16 when size covers the complete header and its magic matches, and
+	// 0 for a short buffer or a header whose magic is not DXA_HEAD.
+	static uint16_t CryptVersionFromHeader(const void* data, const size_t& size) noexcept;
+
+	// The bounded mode-trial driver shared by WolfDec::detectMode and any source caller: when mode
+	// names a single explicit index only that candidate is attempted, otherwise every combined
+	// default-then-additional candidate is tried in order and the first success wins. On success
