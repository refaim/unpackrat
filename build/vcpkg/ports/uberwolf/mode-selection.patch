 using CryptModes = std::vector<CryptMode>;
 
+// The candidate test the shared trial driver runs for one mode index: it attempts to unpack the
+// archive with that mode and reports whether the attempt succeeded.
+using ModeAttempt = std::function<bool(uint32_t)>;
+
+// The automatic mode decision WolfDec::UnpackArchive makes for an archive header's crypt
+// version when no explicit mode is set. It mirrors the original classification exactly: a
+// version of 0x0 selects the trial policy, a Wolf RPG Pro companion version (>= 1000) and the
+// ChaCha2 Pro version (0xC8) defer to the companion key recovery, and every other nonzero
+// version is looked up in the ordered crypt-mode storage.
+enum class CryptVersionClass : uint8_t
+{
+	Trial,       // 0x0: no header version, the builtin modes must be tried in order
+	ProRecovery, // >= 1000: Wolf RPG Pro companion key recovery
+	Cc2Recovery, // 0xC8: ChaCha2 Pro companion key recovery
+	ExactMatch,  // any other nonzero version: an exact crypt-mode lookup
+};
+
+// The decision and the header version it was made from. The version is carried unchanged, so a
+// caller that later performs Pro crypto keeps the real header version: a version >= 1020 stays
+// 1020 and is never rewritten to 1010.
+struct CryptVersionDecision
+{
+	CryptVersionClass classification = CryptVersionClass::Trial;
+	uint16_t cryptVersion = 0;
+};
