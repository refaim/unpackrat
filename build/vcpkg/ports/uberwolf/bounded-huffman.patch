@@ -0,0 +1,466 @@
+#pragma once
+
+// ============================================================================
+//  Shared bounded Huffman decoder for the DXLib "Huffman" stream.
+//
+//  This is the single decoder implementation for Wolf RPG archives.  It
+//  reproduces the header parse, weight reconstruction, tree build and
+//  root-to-leaf payload traversal of the original DXLib Huffman_Decode
+//  (3rdParty/DXLib/Huffman.cpp) while validating every extent and arithmetic
+//  operation before it is used:
+//
+//    * the original initialisation loop walked 256 + 255 nodes while only 256
+//      weights exist, reading Weight[256 .. 510] out of bounds on valid input.
+//      Here the leaves are exactly 256 and the internal nodes exactly 255.
+//    * the header, the weight table and the payload are pulled through a
+//      bounded, resumable source that never over-reads and latches end of
+//      input, instead of reading a raw pointer without a length.
+//    * a reconstructed weight that leaves [0, 65535] is rejected rather than
+//      wrapping through a u16.
+//    * payload traversal is a plain root-to-leaf walk, so it never relies on
+//      the original "last 17 bytes" lookahead that underflowed for short
+//      outputs and read ahead of the buffer.
+//    * a byte source that reports more bytes than the destination can hold
+//      violates the pull contract and is rejected as a source failure before its
+//      claim can index past the fixed 8 KiB window.
+//
+//  The decoder is header-only, allocation free (fixed arrays) and resumable:
+//  read() may be called repeatedly with caller-owned output buffers, and at
+//  most one 8 KiB source window is buffered.  No exception may cross the byte
+//  source callback; a callback that cannot continue returns source_failed.
+// ============================================================================
+
+#include <cstddef>
+#include <cstdint>
+
+namespace uberwolf
+{
+namespace archive
+{
+    enum class huffman_status : std::uint8_t
+    {
+        ok = 0,
+        header_truncated,
+        original_exceeds_bound,
+        original_mismatch,
+        weight_out_of_range,
+        payload_exceeds_extent,
+        trailing_bytes,
+        empty_with_payload,
+        payload_truncated,
+        payload_not_consumed,
+        source_failure,
+    };
+
+    enum class huffman_size_mode : std::uint8_t
+    {
+        // The caller knows the exact decoded size; a differing header original is rejected.
+        exact = 0,
+        // The caller gives a decoded-size ceiling; a larger header original is rejected as soon as
+        // it has been decoded, before a single weight or payload byte is requested.
+        bounded,
+        // Legacy pointer API: neither the encoded extent nor the decoded size is known, so the
+        // stream's own header sizes are trusted and the source is read one byte at a time.
+        opaque,
+    };
+
+    class bounded_huffman
+    {
+      public:
+        // Fills destination[0, capacity) and returns the number of bytes written, which must be at
+        // most capacity, 0 at end of input, or source_failed when the source cannot continue.  The
+        // callback must not throw.
+        using pull_fn = std::size_t (*)(void *context, unsigned char *destination, std::size_t capacity);
+
+        static constexpr std::size_t source_failed = static_cast<std::size_t>(-1);
+        static constexpr std::size_t leaf_count = 256;
+        static constexpr std::size_t node_count = 256 + 255;
+        static constexpr std::int32_t root_index = static_cast<std::int32_t>(node_count - 1);
+        static constexpr std::size_t window_size = 8192;
+
+        bounded_huffman() = default;
+
+        // Parses and validates the stream header, reconstructs the 256 weights and builds the tree.
+        // ``encoded_size`` is the declared encoded extent (header plus payload) for the exact and
+        // bounded modes; the opaque mode ignores it.
+        //
+        // Lifecycle: a context is initialised exactly once. init runs on a freshly constructed
+        // context and must return ok before any read(); read() requires that successful init. init
+        // does not reset the window, counters or status, so it is not a re-initialisation entry
+        // point and one stream needs one context. The pull callback is called synchronously from
+        // init and read, must not re-enter this context, and must not throw.
+        huffman_status init(pull_fn pull, void *context, huffman_size_mode mode, std::uint64_t encoded_size,
+                            std::uint64_t expected_size) noexcept;
+
+        // Decodes up to ``capacity`` bytes into ``destination`` and stores the count in ``written``.
+        // Resumable: a count below ``capacity`` means the declared output has been produced.
+        huffman_status read(unsigned char *destination, std::size_t capacity, std::size_t *written) noexcept;
+
+        [[nodiscard]] std::uint64_t original_size() const noexcept
+        {
+            return original_size_;
+        }
+
+        [[nodiscard]] std::uint64_t produced() const noexcept
+        {
+            return produced_;
+        }
+
+        [[nodiscard]] std::uint64_t remaining() const noexcept
+        {
+            return original_size_ - produced_;
+        }
+
+      private:
+        bool read_msb(unsigned count, std::uint64_t &value) noexcept;
+        int next_byte(huffman_status truncation) noexcept;
+        int next_payload_bit() noexcept;
+        int load_payload_byte() noexcept;
+        void build_tree() noexcept;
+
+        pull_fn pull_ = nullptr;
+        void *context_ = nullptr;
+        bool extent_known_ = false;
+        bool probe_ = false;
+        huffman_status pending_ = huffman_status::ok;
+
+        std::uint64_t encoded_size_ = 0;
+        std::uint64_t original_size_ = 0;
+        std::uint64_t produced_ = 0;
+        std::uint64_t fetched_ = 0;
+        std::uint64_t consumed_ = 0;
+        std::uint64_t payload_remaining_ = 0;
+
+        std::size_t buffer_pos_ = 0;
+        std::size_t buffer_len_ = 0;
+        unsigned char buffer_[window_size]{};
+
+        std::uint8_t msb_byte_ = 0;
+        unsigned msb_bits_ = 0;
+        std::uint8_t lsb_byte_ = 0;
+        unsigned lsb_bits_ = 0;
+
+        std::uint32_t weights_[leaf_count]{};
+        std::int32_t child0_[node_count]{};
+        std::int32_t child1_[node_count]{};
+    };
+
+    inline bool bounded_huffman::read_msb(unsigned count, std::uint64_t &value) noexcept
+    {
+        value = 0;
+        for (unsigned i = 0; i < count; ++i)
+        {
+            if (msb_bits_ == 0)
+            {
+                const int next = next_byte(huffman_status::header_truncated);
+                if (next < 0)
+                {
+                    return false;
+                }
+                msb_byte_ = static_cast<std::uint8_t>(next);
+                msb_bits_ = 8;
+            }
+            value = (value << 1) | static_cast<std::uint64_t>(msb_byte_ >> 7);
+            msb_byte_ = static_cast<std::uint8_t>(msb_byte_ << 1);
+            --msb_bits_;
+        }
+        return true;
+    }
+
+    inline int bounded_huffman::next_byte(huffman_status truncation) noexcept
+    {
+        // Every caller returns the instant a fetch fails and the source can never re-enter this
+        // context, so next_byte only runs while pending_ is still ok. A failed fetch is therefore
+        // the last thing the running parser will see, and storing the status directly is the same
+        // as the former "if (pending_ == ok)" guard without its always-true branch.
+        if (buffer_pos_ == buffer_len_)
+        {
+            if (extent_known_ && fetched_ >= encoded_size_)
+            {
+                pending_ = truncation;
+                return -1;
+            }
+
+            const std::uint64_t limit =
+                extent_known_ ? (encoded_size_ - fetched_) : static_cast<std::uint64_t>(window_size);
+            std::uint64_t capacity = limit < static_cast<std::uint64_t>(window_size) ? limit
+                                                                                      : static_cast<std::uint64_t>(window_size);
+            if (probe_ && capacity > 1)
+            {
+                // Until the header's original size has been validated against the caller's ceiling,
+                // pull exactly one byte per call so a bound violation is detected as soon as the size
+                // is known, without ever handing a normally filling source a request large enough to
+                // carry weight or payload bytes.
+                capacity = 1;
+            }
+
+            const std::size_t want = static_cast<std::size_t>(capacity);
+            const std::size_t got = pull_(context_, buffer_, want);
+            if (got == source_failed)
+            {
+                pending_ = huffman_status::source_failure;
+                return -1;
+            }
+            if (got > want)
+            {
+                // The source claimed more bytes than the destination can hold. The fixed window
+                // would overflow and buffer_len_ would describe bytes that were never written, so
+                // the whole stream is abandoned as a source failure rather than trusted.
+                pending_ = huffman_status::source_failure;
+                return -1;
+            }
+            if (got == 0)
+            {
+                // End of input. No further byte can ever appear, and the caller returns before it can
+                // ask again, so this truncation status is the latched one.
+                pending_ = truncation;
+                return -1;
+            }
+            fetched_ += got;
+            buffer_len_ = got;
+            buffer_pos_ = 0;
+        }
+        ++consumed_;
+        return static_cast<int>(buffer_[buffer_pos_++]);
+    }
+
+    inline int bounded_huffman::load_payload_byte() noexcept
+    {
+        if (payload_remaining_ == 0)
+        {
+            // The declared payload is spent before the declared output is complete, so the stream is
+            // truncated. Only reached with pending_ == ok, for the reason given in next_byte.
+            pending_ = huffman_status::payload_truncated;
+            return -1;
+        }
+        const int value = next_byte(huffman_status::payload_truncated);
+        if (value < 0)
+        {
+            return -1;
+        }
+        --payload_remaining_;
+        return value;
+    }
+
+    inline int bounded_huffman::next_payload_bit() noexcept
+    {
+        if (lsb_bits_ == 0)
+        {
+            const int value = load_payload_byte();
+            if (value < 0)
+            {
+                return -1;
+            }
+            lsb_byte_ = static_cast<std::uint8_t>(value);
+            lsb_bits_ = 8;
+        }
+        const int bit = lsb_byte_ & 1;
+        lsb_byte_ = static_cast<std::uint8_t>(lsb_byte_ >> 1);
+        --lsb_bits_;
+        return bit;
+    }
+
+    inline void bounded_huffman::build_tree() noexcept
+    {
+        std::int32_t parent[node_count];
+        std::uint32_t weight[node_count];
+        for (std::size_t i = 0; i < node_count; ++i)
+        {
+            parent[i] = -1;
+            child0_[i] = -1;
+            child1_[i] = -1;
+        }
+        for (std::size_t i = 0; i < leaf_count; ++i)
+        {
+            weight[i] = weights_[i];
+        }
+
+        std::size_t roots = leaf_count;
+        std::size_t next = leaf_count;
+        while (roots > 1)
+        {
+            std::int32_t first = -1;
+            std::int32_t second = -1;
+            std::size_t index = 0;
+            std::size_t seen = 0;
+            while (seen < roots)
+            {
+                if (parent[index] != -1)
+                {
+                    ++index;
+                    continue;
+                }
+                ++seen;
+                if (first < 0 || weight[static_cast<std::size_t>(first)] > weight[index])
+                {
+                    second = first;
+                    first = static_cast<std::int32_t>(index);
+                }
+                else if (second < 0 || weight[static_cast<std::size_t>(second)] > weight[index])
+                {
+                    second = static_cast<std::int32_t>(index);
+                }
+                ++index;
+            }
+
+            weight[next] = weight[static_cast<std::size_t>(first)] + weight[static_cast<std::size_t>(second)];
+            child0_[next] = first;
+            child1_[next] = second;
+            parent[static_cast<std::size_t>(first)] = static_cast<std::int32_t>(next);
+            parent[static_cast<std::size_t>(second)] = static_cast<std::int32_t>(next);
+            ++next;
+            --roots;
+        }
+    }
+
+    inline huffman_status bounded_huffman::init(pull_fn pull, void *context, huffman_size_mode mode,
+                                                std::uint64_t encoded_size, std::uint64_t expected_size) noexcept
+    {
+        pull_ = pull;
+        context_ = context;
+        extent_known_ = mode != huffman_size_mode::opaque;
+        // The exact mode knows the encoded extent, so it can buffer normally from the first byte.
+        // The bounded mode probes one byte at a time until the original size is validated, then
+        // buffers normally.  The opaque mode has no extent at all and therefore stays byte-at-a-time
+        // for the whole stream, exactly like the original pointer reader.
+        probe_ = mode != huffman_size_mode::exact;
+        encoded_size_ = encoded_size;
+
+        std::uint64_t field = 0;
+        if (!read_msb(6, field))
+        {
+            return pending_;
+        }
+        std::uint64_t original = 0;
+        if (!read_msb(static_cast<unsigned>(field + 1), original))
+        {
+            return pending_;
+        }
+        // The original size is now known: the bounded-mode one-byte probe is done and the caller's
+        // ceiling can be enforced before a single weight or payload byte is requested.
+        if (mode == huffman_size_mode::bounded)
+        {
+            probe_ = false;
+        }
+        original_size_ = original;
+        if (mode == huffman_size_mode::bounded)
+        {
+            if (original > expected_size)
+            {
+                return huffman_status::original_exceeds_bound;
+            }
+        }
+        else if (mode == huffman_size_mode::exact)
+        {
+            if (original != expected_size)
+            {
+                return huffman_status::original_mismatch;
+            }
+        }
+
+        if (!read_msb(6, field))
+        {
+            return pending_;
+        }
+        std::uint64_t pressed = 0;
+        if (!read_msb(static_cast<unsigned>(field + 1), pressed))
+        {
+            return pending_;
+        }
+
+        std::int64_t previous = 0;
+        for (std::size_t i = 0; i < leaf_count; ++i)
+        {
+            std::uint64_t width_field = 0;
+            if (!read_msb(3, width_field))
+            {
+                return pending_;
+            }
+            const unsigned width = static_cast<unsigned>(width_field + 1) * 2u;
+            std::uint64_t negative = 0;
+            if (!read_msb(1, negative))
+            {
+                return pending_;
+            }
+            std::uint64_t magnitude = 0;
+            if (!read_msb(width, magnitude))
+            {
+                return pending_;
+            }
+            const std::int64_t signed_magnitude = static_cast<std::int64_t>(magnitude);
+            const std::int64_t value = i == 0
+                                           ? signed_magnitude
+                                           : (negative != 0 ? previous - signed_magnitude
+                                                            : previous + signed_magnitude);
+            if (value < 0 || value > 0xFFFF)
+            {
+                return huffman_status::weight_out_of_range;
+            }
+            weights_[i] = static_cast<std::uint32_t>(value);
+            previous = value;
+        }
+
+        if (extent_known_)
+        {
+            // The declared stream is exactly the header plus the declared payload: no byte may sit
+            // outside the pressed extent, and no declared payload byte may be missing.
+            const std::uint64_t payload_capacity = encoded_size_ - consumed_;
+            if (pressed > payload_capacity)
+            {
+                return huffman_status::payload_exceeds_extent;
+            }
+            if (pressed < payload_capacity)
+            {
+                return huffman_status::trailing_bytes;
+            }
+            if (original_size_ == 0 && pressed != 0)
+            {
+                return huffman_status::empty_with_payload;
+            }
+        }
+        payload_remaining_ = pressed;
+        build_tree();
+        return huffman_status::ok;
+    }
+
+    inline huffman_status bounded_huffman::read(unsigned char *destination, std::size_t capacity,
+                                                std::size_t *written) noexcept
+    {
+        if (pending_ != huffman_status::ok)
+        {
+            *written = 0;
+            return pending_;
+        }
+
+        std::size_t count = 0;
+        while (count < capacity && produced_ < original_size_)
+        {
+            std::int32_t node = root_index;
+            // Every child index is strictly below its parent, so the walk terminates after at most
+            // 255 steps and can never cycle back into a non-leaf.
+            while (node > static_cast<std::int32_t>(leaf_count - 1))
+            {
+                const int bit = next_payload_bit();
+                if (bit < 0)
+                {
+                    *written = count;
+                    return pending_;
+                }
+                node = bit != 0 ? child1_[static_cast<std::size_t>(node)]
+                                : child0_[static_cast<std::size_t>(node)];
+            }
+            destination[count] = static_cast<unsigned char>(node);
+            ++count;
+            ++produced_;
+        }
+
+        if (produced_ == original_size_ && extent_known_ && payload_remaining_ != 0)
+        {
+            *written = count;
+            return huffman_status::payload_not_consumed;
+        }
+        *written = count;
+        return huffman_status::ok;
+    }
