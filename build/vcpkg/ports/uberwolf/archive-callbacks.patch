+// ---------------------------------------------------------------------------------------------------
+// 共有の有界コーデック。メタデータ解析とボディ展開は、同じ Huffman / LZ カーネルと、同じ
+// ボディ幾何ヘルパを共有する。ディスク上のデータに触れる前に、すべての範囲と算術を検査する。
+// ---------------------------------------------------------------------------------------------------
+
+// 出力 / 進捗へ渡すチャンクの上限
+#define DXA_OUTPUT_CHUNK  (32 * 1024)
+
+// 操作ローカルの古典的なバイト変換。Transform が NULL なら変換なし( NO_KEY )。変換はベンダの
+// 論理位置で適用する( メタデータはブロック内オフセット、ボディは DataSize + ボディ内物理オフセット )。
+struct DXA_CIPHER
+{
+	void *Context;
+	void (*Transform)( void *Context, void *Data, size_t Size, u64 Position );
+};
+
+// 操作ローカルの古典鍵。KeyConv に明示的な鍵を渡すためだけに保持する。
+struct DXA_CLASSIC_KEY
+{
+	unsigned char Key[ DXA_KEY_BYTES ];
+};
+
+// 操作ローカルの古典変換。DXArchive::KeyConv はプロセス全体の暗号モードフラグを参照するため
+// ここでは使わず、グローバルに依存しない純粋な apply_key_xor へ直接委譲する。
+static void DXA_ClassicTransform( void *Context, void *Data, size_t Size, u64 Position )
+{
+	DXA_CLASSIC_KEY *Classic = static_cast<DXA_CLASSIC_KEY *>( Context );
+	wolf::archive::classic::apply_key_xor(
+		std::span<std::byte>( static_cast<std::byte *>( Data ), Size ),
+		(size_t)( Position % wolf::archive::classic::key_bytes ),
+		std::span<const unsigned char, wolf::archive::classic::key_bytes>( Classic->Key, wolf::archive::classic::key_bytes ) );
+}
+
+// ボディの物理レイアウトはヘッダの公開型を共有する( 走査・展開・ファイル経路で単一の型 )
+typedef DXArchive::BodyPlan DXA_BODY_PLAN;
+
+// ボディ幾何の唯一の情報源。走査カーネルと展開器が同じ物理範囲を計算する。
+// partial: HSize + N - 2K、full: HSize、no-Huff: N。
+static int DXA_ComputeBodyPlan( u64 DataSize, u64 PressSize, u64 HuffSize, u8 HuffmanEncodeKB, DXA_BODY_PLAN &Plan )
+{
+	Plan.Huff        = ( HuffSize != 0xffffffffffffffffULL );
+	Plan.Lz          = ( PressSize != 0xffffffffffffffffULL );
+	Plan.OutputSize  = DataSize;
+	Plan.HuffEncoded = Plan.Huff ? HuffSize : 0;
+	Plan.Front       = 0;
+	Plan.RawMiddle   = 0;
+
+	const u64 N  = Plan.Lz ? PressSize : DataSize;
+	Plan.N = N;
+
+	if( Plan.Huff )
+	{
+		const u64 K       = (u64)HuffmanEncodeKB * 1024;
+		const bool Partial = ( HuffmanEncodeKB != 0xff ) && ( N > 2 * K );
+		if( Partial )
+		{
+			Plan.Front     = K;
+			Plan.RawMiddle = N - 2 * K;
+		}
+		else
+		{
+			Plan.Front = N;
+		}
+		if( Plan.RawMiddle > 0xffffffffffffffffULL - HuffSize ) return -1;
+		Plan.Physical = HuffSize + Plan.RawMiddle;
+	}
+	else
+	{
+		Plan.Physical = N;
+	}
+	return 0;
+}
+
+// ボディ範囲 [BodyStart, BodyStart + BodySize) がメタデータブロック範囲
+// [MetaStart, MetaStart + MetaSpan) と重ならないことを検証する。ボディはメタデータの前でも
+// 後ろでもよく( 上流は物理末尾、メタデータ先頭配置もある )、重なりのみを拒否する。
+// 呼び出し側は BodyStart と MetaStart+MetaSpan の加算オーバーフローを除いて MetaSpan を
+// 既に有界にしていること。
+static bool DXA_BodyDisjointFromMetadata( u64 MetaStart, u64 MetaSpan, u64 BodyStart, u64 BodySize )
+{
+	// 呼び出し元は BodyStart+BodySize と MetaStart+MetaSpan を PhysicalSize 以下に検査済みで、
+	// ここでの加算はオーバーフローしない。
+	const u64 BodyEnd   = BodyStart + BodySize;
+	const u64 MetaEnd   = MetaStart + MetaSpan;
+	if( BodyEnd <= MetaStart ) return true;	// メタデータより前
+	if( BodyStart >= MetaEnd ) return true;	// メタデータより後ろ
+	return false;							// 重なり
+}
+
+// レコードのボディ幾何を検証する唯一の決定点。走査カーネルと展開器が同じ物理範囲と計画を
+// 共有する。範囲の加減算はすべて検査し、メタデータブロックとの重なりもここで拒否する。
+static int DXA_ResolveBodyGeometry( const DARC_HEAD &Head, u64 PhysicalSize, u64 DataAddress,
+	u64 DataSize, u64 PressSize, u64 HuffSize, u64 &BodyAddress, DXArchive::BodyPlan &Plan )
+{
+	const u64 DataStart = (u64)Head.DataStartAddress;
+
+	if( DXA_ComputeBodyPlan( DataSize, PressSize, HuffSize, Head.HuffmanEncodeKB, Plan ) != 0 ) return DXArchive::SOURCE_RESULT_FORMAT;
+	if( DataAddress > PhysicalSize || PhysicalSize - DataAddress < DataStart ) return DXArchive::SOURCE_RESULT_FORMAT;
+	BodyAddress = DataStart + DataAddress;
+	if( PhysicalSize - BodyAddress < Plan.Physical ) return DXArchive::SOURCE_RESULT_FORMAT;
+
+	// メタデータブロックの物理範囲を確定する。非圧縮メタデータは宣言された HeadSize だけ
+	// 物理的に存在する( 疎なボディを飲み込まない )。圧縮メタデータは ParseMetadata と同じ
+	// 規則で範囲を求める。DataStart/FileNameTableStartAddress はオープン時に検査済みで、
+	// DataStart は物理末尾を越えない。
+	const u64 MetaStart = (u64)Head.FileNameTableStartAddress;
+	const bool HeaderCompressed = ( Head.Flags & DXA_FLAG_NO_HEAD_PRESS ) == 0;
+	u64 MetaSpan;
+	if( HeaderCompressed == false )
+	{
+		MetaSpan = (u64)Head.HeadSize;
+	}
+	else if( DataStart > MetaStart )
+	{
+		MetaSpan = DataStart - MetaStart;
+	}
+	else
+	{
+		MetaSpan = PhysicalSize - MetaStart;
+	}
+	if( !DXA_BodyDisjointFromMetadata( MetaStart, MetaSpan, BodyAddress, Plan.Physical ) ) return DXArchive::SOURCE_RESULT_FORMAT;
+	return DXArchive::SOURCE_RESULT_OK;
+}
+
+// 論理ソース位置の基点を伴う読み取り。例外はここで捕捉して保持し、コーデクのエラー翻訳より
+// 先に再送出する。各読み取りの前に保持した例外を消す。
+struct DXA_SOURCE_READER
+{
+	const DXArchive::Source *Src;
+	const DXA_CIPHER        *Cipher;
+	u64                       Base;
+	u64                       LogicalBase;
+	std::exception_ptr        Error;
+	bool                      Failed;
+
+	bool Read( u64 Offset, void *Data, size_t Size )
+	{
+		if( Size == 0 ) return true;
+		Error = nullptr;
+		try
+		{
+			if( !Src->read_at( (s64)( Base + Offset ), Data, Size ) )
+			{
+				Failed = true;
+				return false;
+			}
+		}
+		catch( ... )
+		{
+			Error  = std::current_exception();
+			Failed = true;
+			return false;
+		}
+		if( Cipher != nullptr && Cipher->Transform != nullptr )
+		{
+			Cipher->Transform( Cipher->Context, Data, Size, LogicalBase + Offset );
+		}
+		return true;
+	}
+};
+
+// Huffman カーネルへ供給する有界プル。ソース失敗は source_failed として伝える。
+struct DXA_HUFF_PULL
+{
+	DXA_SOURCE_READER *Reader;
+	u64                Offset;
+	u64                End;
+};
+
+static size_t DXA_HuffPullFn( void *Context, unsigned char *Destination, size_t Capacity )
+{
+	DXA_HUFF_PULL *Pull = static_cast<DXA_HUFF_PULL *>( Context );
+	const u64      Left = Pull->End - Pull->Offset;
+	const size_t   Want = (size_t)( (u64)Capacity < Left ? (u64)Capacity : Left );
+	if( Want == 0 ) return 0;
+	if( !Pull->Reader->Read( Pull->Offset, Destination, Want ) )
+	{
+		return uberwolf::archive::bounded_huffman::source_failed;
+	}
+	Pull->Offset += Want;
+	return Want;
+}
+
+// midstream = コーデック後段( LZ 入力、または LZ 無しの最終データ )。
+// RAW: ディスク上の生バイト、HUFF: Huffman 展開の全体、EDGES: 前後 K エッジ + 生の中間。
+enum DXA_MID_KIND { DXA_MID_RAW = 0, DXA_MID_HUFF = 1, DXA_MID_EDGES = 2 };
+
+struct DXA_MIDSTREAM
+{
+	DXA_SOURCE_READER *Reader;
+	DXA_MID_KIND       Kind;
+	u64                Total;
+	u64                Position;
+	u64                Front;		// EDGES: K
+	u64                Middle;		// EDGES: N - 2K
+	u64                HuffEncoded;	// EDGES: 生中間のディスクオフセット
+	uberwolf::archive::bounded_huffman *Huff;	// HUFF
+	std::vector<u8>    Edges;		// EDGES: 2K
+	bool               Failed;			// コーデック( ストリーム )の破損
+	bool               SourceFailed;	// バイトソースの読み込み失敗
+
+	size_t Pull( void *Destination, size_t Capacity )
+	{
+		if( Failed || Position >= Total ) return 0;
+		const u64    Left = Total - Position;
+		const size_t Want = (size_t)( (u64)Capacity < Left ? (u64)Capacity : Left );
+		if( Want == 0 ) return 0;
+
+		if( Kind == DXA_MID_RAW )
+		{
+			if( !Reader->Read( Position, Destination, Want ) ) { SourceFailed = true; return 0; }
+			Position += Want;
+			return Want;
+		}
+
+		if( Kind == DXA_MID_HUFF )
+		{
+			size_t Written = 0;
+			const uberwolf::archive::huffman_status Status = Huff->read( (unsigned char *)Destination, Want, &Written );
+			Position += Written;
+			if( Status != uberwolf::archive::huffman_status::ok )
+			{
+				if( Status == uberwolf::archive::huffman_status::source_failure ) SourceFailed = true;
+				else Failed = true;
+			}
+			return Written;
+		}
+
+		// EDGES
+		if( Position < Front )
+		{
+			const u64 Take = ( Front - Position ) < Want ? ( Front - Position ) : Want;
+			memcpy( Destination, Edges.data() + (size_t)Position, (size_t)Take );
+			Position += Take;
+			return (size_t)Take;
+		}
+		if( Position < Front + Middle )
+		{
+			const u64 Consumed = Position - Front;
+			const u64 Avail    = Middle - Consumed;
+			const u64 Take     = Avail < Want ? Avail : Want;
+			if( !Reader->Read( HuffEncoded + Consumed, Destination, (size_t)Take ) ) { SourceFailed = true; return 0; }
+			Position += Take;
+			return (size_t)Take;
+		}
+		const u64 TailPos = Position - Front - Middle;
+		const u64 Take    = ( Front - TailPos ) < Want ? ( Front - TailPos ) : Want;
+		memcpy( Destination, Edges.data() + (size_t)( Front + TailPos ), (size_t)Take );
+		Position += Take;
+		return (size_t)Take;
+	}
+};
+
+// 出力 / 進捗コールバックの中断をコーデクへ伝える内部キャリア。非 0 の戻り値は Code で、
+// コールバックが送出した任意の例外は Exception に保持して、コーデクのエラー翻訳より先に
+// そのまま再送出する( 出力 / 進捗の出自を失わせない )。
+struct DXA_OUTPUT_ABORT
+{
+	int                Code;
+	std::exception_ptr Exception;
+};
+
+// LZ 展開の出力リング。履歴は最長参照距離までで足りるので、ボディ全体を保持しない。
+struct DXA_RING_SINK
+{
+	std::vector<u8> Ring;
+	u64             Produced;
+	std::vector<u8> Staging;
+	const std::function<int( const void *, size_t )> *Output;
+	const std::function<int( u64 )> *Progress;
+	u64             OutputSize;
+};
+
+static void DXA_RingFlush( DXA_RING_SINK *Sink )
+{
+	if( Sink->Staging.empty() ) return;
+	int Result = 0;
+	try
+	{
+		Result = ( *Sink->Output )( Sink->Staging.data(), Sink->Staging.size() );
+	}
+	catch( ... )
+	{
+		Sink->Staging.clear();
+		throw DXA_OUTPUT_ABORT{ 0, std::current_exception() };
+	}
+	Sink->Staging.clear();
+	if( Result != 0 ) throw DXA_OUTPUT_ABORT{ Result, nullptr };
+	if( *Sink->Progress )
+	{
+		int ProgressResult = 0;
+		try
+		{
+			ProgressResult = ( *Sink->Progress )( Sink->Produced );
+		}
+		catch( ... )
+		{
+			throw DXA_OUTPUT_ABORT{ 0, std::current_exception() };
+		}
+		if( ProgressResult != 0 ) throw DXA_OUTPUT_ABORT{ ProgressResult, nullptr };
+	}
+}
+
+static std::byte DXA_RingRead( void *Context, u64 Position )
+{
+	DXA_RING_SINK *Sink = static_cast<DXA_RING_SINK *>( Context );
+	return (std::byte)Sink->Ring[ (size_t)( Position % (u64)Sink->Ring.size() ) ];
+}
+
+static void DXA_RingWrite( void *Context, std::byte Value )
+{
+	DXA_RING_SINK *Sink = static_cast<DXA_RING_SINK *>( Context );
+	Sink->Ring[ (size_t)( Sink->Produced % (u64)Sink->Ring.size() ) ] = (u8)Value;
+	Sink->Staging.push_back( (u8)Value );
+	++Sink->Produced;
+	if( Sink->Staging.size() >= DXA_OUTPUT_CHUNK || Sink->Produced == Sink->OutputSize )
+	{
+		DXA_RingFlush( Sink );
+	}
+}
+
+// 検証済みのボディ一つを有界に展開する。鍵なし( NO_KEY )を前提とし、鍵付きは呼び出し側で
+// 拒否する。コーデクのエラーは SOURCE_RESULT に、出力 / 進捗の戻り値はそのまま返す。
+static int DXA_DecodeBodyStream( DXA_SOURCE_READER &Reader, const DXA_BODY_PLAN &Plan,
+	const std::function<int( const void *, size_t )> &Output, const std::function<int( u64 )> &Progress )
+{
+	if( Output == nullptr ) return DXArchive::SOURCE_RESULT_FORMAT;
+
+	std::vector<u8> EdgeBuf;
+	uberwolf::archive::bounded_huffman HuffCtx;
+	DXA_HUFF_PULL HuffPull = { &Reader, 0, 0 };
+
+	DXA_MIDSTREAM Mid = {};
+	Mid.Reader = &Reader;
+	Mid.Kind   = DXA_MID_RAW;
+	Mid.Total  = Plan.N;
+
+	if( Plan.Huff )
+	{
+		const u64 Expected = Plan.RawMiddle != 0 ? 2 * Plan.Front : Plan.N;
+		HuffPull.Offset = 0;
+		HuffPull.End    = Plan.HuffEncoded;
+		const uberwolf::archive::huffman_status Status = HuffCtx.init( DXA_HuffPullFn, &HuffPull,
+			uberwolf::archive::huffman_size_mode::exact, Plan.HuffEncoded, Expected );
+		if( Status != uberwolf::archive::huffman_status::ok )
+		{
+			if( Reader.Error ) std::rethrow_exception( Reader.Error );
+			if( Reader.Failed ) return DXArchive::SOURCE_RESULT_SOURCE;
+			return DXArchive::SOURCE_RESULT_FORMAT;
+		}
+		if( Plan.RawMiddle != 0 )
+		{
+			EdgeBuf.resize( (size_t)( 2 * Plan.Front ) );
+			size_t Got = 0;
+			const uberwolf::archive::huffman_status ReadStatus = HuffCtx.read( EdgeBuf.data(), EdgeBuf.size(), &Got );
+			if( ReadStatus != uberwolf::archive::huffman_status::ok || Got != EdgeBuf.size() )
+			{
+				if( Reader.Error ) std::rethrow_exception( Reader.Error );
+				if( Reader.Failed || ReadStatus == uberwolf::archive::huffman_status::source_failure ) return DXArchive::SOURCE_RESULT_SOURCE;
+				return DXArchive::SOURCE_RESULT_FORMAT;
+			}
+			Mid.Kind        = DXA_MID_EDGES;
+			Mid.Edges       = std::move( EdgeBuf );
+			Mid.Front       = Plan.Front;
+			Mid.Middle      = Plan.RawMiddle;
+			Mid.HuffEncoded = Plan.HuffEncoded;
+		}
+		else
+		{
+			Mid.Kind = DXA_MID_HUFF;
+			Mid.Huff = &HuffCtx;
+		}
+	}
+
+	if( Plan.Lz )
+	{
+		const u64 History = Plan.OutputSize < wolf::archive::boundedlz::max_distance
+			? Plan.OutputSize : wolf::archive::boundedlz::max_distance;
+		DXA_RING_SINK Sink = {};
+		Sink.Ring.resize( (size_t)( History ? History : 1 ) );
+		Sink.Output     = &Output;
+		Sink.Progress   = &Progress;
+		Sink.OutputSize = Plan.OutputSize;
+
+		auto Pull = [&Mid]( std::span<std::byte> Destination ) -> size_t
+		{
+			return Mid.Pull( Destination.data(), Destination.size() );
+		};
+
+		try
+		{
+			wolf::archive::boundedlz::context Ctx( std::move( Pull ), Plan.N, Plan.OutputSize );
+			wolf::archive::boundedlz::emitter Emit = { &DXA_RingRead, &DXA_RingWrite, &Sink };
+			while( Ctx.produce( DXA_OUTPUT_CHUNK, Emit ) != 0 ) {}
+			DXA_RingFlush( &Sink );
+		}
+		catch( const DXA_OUTPUT_ABORT &Abort )
+		{
+			if( Abort.Exception ) std::rethrow_exception( Abort.Exception );
+			return Abort.Code;
+		}
+		catch( const wolf::archive::boundedlz::error & )
+		{
+			if( Reader.Error ) std::rethrow_exception( Reader.Error );
+			if( Reader.Failed || Mid.SourceFailed ) return DXArchive::SOURCE_RESULT_SOURCE;
+			return DXArchive::SOURCE_RESULT_FORMAT;
+		}
+		if( Reader.Failed || Mid.SourceFailed ) return DXArchive::SOURCE_RESULT_SOURCE;
+		if( Mid.Failed ) return DXArchive::SOURCE_RESULT_FORMAT;
+		return DXArchive::SOURCE_RESULT_OK;
+	}
+
+	std::vector<u8> Buffer( DXA_OUTPUT_CHUNK );
+	u64             Written = 0;
+	for( ;; )
+	{
+		const size_t Got = Mid.Pull( Buffer.data(), Buffer.size() );
+		if( Got == 0 ) break;
+		const int OutputResult = Output( Buffer.data(), Got );
+		if( OutputResult != 0 ) return OutputResult;
+		Written += Got;
+		if( Progress )
+		{
+			const int ProgressResult = Progress( Written );
+			if( ProgressResult != 0 ) return ProgressResult;
+		}
+	}
+	if( Reader.Error ) std::rethrow_exception( Reader.Error );
+	if( Reader.Failed || Mid.SourceFailed ) return DXArchive::SOURCE_RESULT_SOURCE;
+	if( Mid.Failed ) return DXArchive::SOURCE_RESULT_FORMAT;
+	return DXArchive::SOURCE_RESULT_OK;
+}
+
+// メタデータブロック( 非圧縮、または Huffman( LZ( metadata ) ) )を 1 か所で読む。
+// 中間 LZ サイズは共有 Huffman init から得て上限で検査し、最終バッファを LZ 履歴に使う。
+static int DXA_ReadMetadataBlock( DXA_SOURCE_READER &Reader, u64 EncodedExtent, bool Compressed,
+	u8 *Metadata, u64 MetadataSize )
+{
+	if( Metadata == nullptr ) return DXArchive::SOURCE_RESULT_FORMAT;
+
+	if( !Compressed )
+	{
+		if( EncodedExtent < MetadataSize ) return DXArchive::SOURCE_RESULT_FORMAT;
+		if( !Reader.Read( 0, Metadata, (size_t)MetadataSize ) )
+		{
+			if( Reader.Error ) std::rethrow_exception( Reader.Error );
+			return DXArchive::SOURCE_RESULT_SOURCE;
+		}
+		return DXArchive::SOURCE_RESULT_OK;
+	}
+
+	uberwolf::archive::bounded_huffman HuffCtx;
+	DXA_HUFF_PULL HuffPull = { &Reader, 0, EncodedExtent };
+	const uberwolf::archive::huffman_status InitStatus = HuffCtx.init( DXA_HuffPullFn, &HuffPull,
+		uberwolf::archive::huffman_size_mode::bounded, EncodedExtent, DXA_METADATA_MAX );
+	if( InitStatus != uberwolf::archive::huffman_status::ok )
+	{
+		if( Reader.Error ) std::rethrow_exception( Reader.Error );
+		if( Reader.Failed ) return DXArchive::SOURCE_RESULT_SOURCE;
+		return DXArchive::SOURCE_RESULT_FORMAT;
+	}
+
+	// init は bounded モードで original <= DXA_METADATA_MAX を不変条件として保証済みなので、
+	// ここで上限を再検査しない。zero 長は下の LZ 文脈が 9 バイトヘッダ未満として FORMAT へ翻訳する。
+	const u64 LzSize = HuffCtx.original_size();
+
+	DXA_MIDSTREAM Mid = {};
+	Mid.Reader = &Reader;
+	Mid.Kind   = DXA_MID_HUFF;
+	Mid.Huff   = &HuffCtx;
+	Mid.Total  = LzSize;
+
+	auto Pull = [&Mid]( std::span<std::byte> Destination ) -> size_t
+	{
+		return Mid.Pull( Destination.data(), Destination.size() );
+	};
+
+	struct DXA_META_SINK
+	{
+		u8 *Out;
+		u64 Pos;
+	};
+	DXA_META_SINK Sink = { Metadata, 0 };
+
+	try
+	{
+		wolf::archive::boundedlz::context Ctx( std::move( Pull ), LzSize, MetadataSize );
+		wolf::archive::boundedlz::emitter Emit = {
+			[]( void *Context, u64 Position ) -> std::byte
+			{
+				return (std::byte)( (const DXA_META_SINK *)Context )->Out[ Position ];
+			},
+			[]( void *Context, std::byte Value )
+			{
+				DXA_META_SINK *State = (DXA_META_SINK *)Context;
+				State->Out[ State->Pos++ ] = (u8)Value;
+			},
+			&Sink,
+		};
+		Ctx.produce( (size_t)MetadataSize, Emit );
+	}
+	catch( const wolf::archive::boundedlz::error & )
+	{
+		if( Reader.Error ) std::rethrow_exception( Reader.Error );
+		if( Reader.Failed || Mid.SourceFailed ) return DXArchive::SOURCE_RESULT_SOURCE;
+		return DXArchive::SOURCE_RESULT_FORMAT;
+	}
+	if( Reader.Failed || Mid.SourceFailed ) return DXArchive::SOURCE_RESULT_SOURCE;
+	if( Mid.Failed ) return DXArchive::SOURCE_RESULT_FORMAT;
+	return DXArchive::SOURCE_RESULT_OK;
+}
+
+// 検証済みメタデータブロックの唯一の所有者。ヘッダ検証・物理範囲確定・確保・復号
+// ( 非圧縮 / Huffman と LZ )を 1 か所に集約し、バッファは RAII で所有する。呼び出し元は
+// data() を借りるだけなので、元の static DecodeArchive と OpenArchive 経路が同じ実装を共有する。
+struct DXA_METADATA
+{
+	std::vector<u8> Bytes;
+};
+
+// 事前条件: Head のマジックとバージョンは検査済み。PhysicalSize は実ファイル長。Key は NoKey の
+// ときでも非 NULL の DXA_KEY_BYTES バッファを指す。保持したソース例外は再送出し、確保失敗も
+// そのまま伝播する。戻り値は SOURCE_RESULT_*。
+static int DXA_LoadMetadata( const DXArchive::Source &Src, const DARC_HEAD &Head, u64 PhysicalSize,
+	const u8 *Key, bool NoKey, DXA_METADATA &Out )
+{
+	// 実ファイル長は呼び出し元から受け取るので、ここで必要なのは読み取り口だけである。
+	if( !Src.read_at ) return DXArchive::SOURCE_RESULT_SOURCE;
+
+	// メタデータ長と各テーブル位置を、割り当て前に検査する( 上限は 64MiB )
+	const u64 HeadSize = (u64)Head.HeadSize;
+	if( HeadSize == 0 || HeadSize > DXA_METADATA_MAX ) return DXArchive::SOURCE_RESULT_FORMAT;
+	if( (u64)Head.FileNameTableStartAddress > PhysicalSize ) return DXArchive::SOURCE_RESULT_FORMAT;
+	if( (u64)Head.FileTableStartAddress > HeadSize ||
+		(u64)Head.DirectoryTableStartAddress > HeadSize ) return DXArchive::SOURCE_RESULT_FORMAT;
+
+	const bool HeaderCompressed = ( Head.Flags & DXA_FLAG_NO_HEAD_PRESS ) == 0;
+
+	// メタデータブロックの物理範囲。本文前置のレイアウトでは本文開始まで、通常は物理末尾まで。
+	u64 MetadataExtent;
+	if( (u64)Head.DataStartAddress > (u64)Head.FileNameTableStartAddress &&
+		(u64)Head.DataStartAddress <= PhysicalSize )
+	{
+		MetadataExtent = (u64)Head.DataStartAddress - (u64)Head.FileNameTableStartAddress;
+	}
+	else
+	{
+		MetadataExtent = PhysicalSize - (u64)Head.FileNameTableStartAddress;
+	}
+	if( MetadataExtent == 0 ) return DXArchive::SOURCE_RESULT_FORMAT;
+
+	u64 EncodedExtent;
+	if( HeaderCompressed == false )
+	{
+		if( HeadSize > MetadataExtent ) return DXArchive::SOURCE_RESULT_FORMAT;
+		EncodedExtent = HeadSize;
+	}
+	else
+	{
+		EncodedExtent = MetadataExtent;
+		if( EncodedExtent > DXA_METADATA_MAX ) return DXArchive::SOURCE_RESULT_FORMAT;
+	}
+
+	// RAII バッファ。確保失敗は呼び出し元へ伝播する。
+	Out.Bytes.assign( (size_t)HeadSize, 0 );
+
+	DXA_CLASSIC_KEY Classic = {};
+	memcpy( Classic.Key, Key, DXA_KEY_BYTES );
+	DXA_CIPHER Cipher;
+	Cipher.Context   = &Classic;
+	Cipher.Transform = NoKey ? NULL : &DXA_ClassicTransform;
+
+	DXA_SOURCE_READER Reader;
+	Reader.Src         = &Src;
+	Reader.Cipher      = NoKey ? NULL : &Cipher;
+	Reader.Base        = Head.FileNameTableStartAddress;
+	Reader.LogicalBase = 0;
+	Reader.Error       = nullptr;
+	Reader.Failed      = false;
+
+	return DXA_ReadMetadataBlock( Reader, EncodedExtent, HeaderCompressed, Out.Bytes.data(), HeadSize );
+}
+
+// 検証済みレコード一つをファイルシステムへ展開する( DirectoryDecode の各レコード処理 )
+int DXArchive::DecodeRecordToFileSystem( u8 *NameP, u8 *DirP, u8 *FileP, DARC_HEAD *Head, FILE *ArcP,
+	unsigned char *Key, const char *KeyString, size_t KeyStringBytes, bool NoKey, char *KeyStringBuffer,
+	const DXArchive::EntryRecord &Record )
+{
+	(void)Key;
+
+	if( Record.IsDirectory )
+	{
+		TCHAR *pDirName = DXA_RawNameToTCHAR( Record.Path, Record.PathBytes );
+		CreateDirectory( pDirName, NULL );
+		delete[] pDirName;
+		return 0;
+	}
+
+	DARC_FILEHEAD *File       = const_cast<DARC_FILEHEAD *>( Record.FileHead );
+	DARC_DIRECTORY *OwningDir = const_cast<DARC_DIRECTORY *>( Record.Directory );
+
+	FILE *DestP;
+
+	// ファイルを開く
+	TCHAR *pName = DXA_RawNameToTCHAR( Record.Path, Record.PathBytes );
+
+	DestP = _tfopen( pName, TEXT("wb") );
+	unsigned char lKey[DXA_KEY_BYTES] = {};
+	size_t KeyStringBufferBytes = 0;
+	// ファイル個別の鍵を作成
+	if( NoKey == false )
+	{
+		KeyStringBufferBytes = CreateKeyFileString( (int)Head->CharCodeFormat, KeyString, KeyStringBytes, OwningDir, File, FileP, DirP, NameP, (BYTE *)KeyStringBuffer );
+		KeyCreate( KeyStringBuffer, KeyStringBufferBytes, lKey );
+	}
+	(void)KeyStringBufferBytes;
+
+	delete[] pName;
+
+	// データがある場合のみ転送する。圧縮 / 非圧縮のボディ分岐は共有の有界コーデックが担う。
+	if( File->DataSize != 0 )
+	{
+		DXA_BODY_PLAN Plan;
+		if( DXA_ComputeBodyPlan( File->DataSize, File->PressDataSize, File->HuffPressDataSize, Head->HuffmanEncodeKB, Plan ) != 0 )
+		{
+			fclose( DestP );
+			return -1;
+		}
+
+		// ファイル個別の鍵があれば、操作ローカルの古典鍵として共有展開器へ渡す。
+		DXA_CLASSIC_KEY Classic = {};
+		DXA_CIPHER Cipher;
+		Cipher.Context   = &Classic;
+		Cipher.Transform = NULL;
+		if( NoKey == false )
+		{
+			memcpy( Classic.Key, lKey, DXA_KEY_BYTES );
+			Cipher.Transform = &DXA_ClassicTransform;
+		}
+
+		DXArchive::Source FileSource;
+		FileSource.read_at = [ArcP]( s64 Offset, void *Destination, size_t Size ) -> bool
+		{
+			if( Size == 0 ) return true;
+			if( _fseeki64( ArcP, Offset, SEEK_SET ) != 0 ) return false;
+			return fread( Destination, 1, Size, ArcP ) == Size;
+		};
+
+		DXA_SOURCE_READER Reader;
+		Reader.Src         = &FileSource;
+		Reader.Cipher      = NoKey ? NULL : &Cipher;
+		Reader.Base        = (u64)( Head->DataStartAddress + File->DataAddress );
+		Reader.LogicalBase = File->DataSize;
+		Reader.Error       = nullptr;
+		Reader.Failed      = false;
+
+		const std::function<int( const void *, size_t )> OutputSink =
+			[DestP]( const void *Data, size_t Size ) -> int
+			{
+				fwrite64( const_cast<void *>( Data ), (s64)Size, DestP );
+				return 0;
+			};
+
+		const int DecodeResult = DXA_DecodeBodyStream( Reader, Plan, OutputSink, {} );
+		if( DecodeResult != SOURCE_RESULT_OK )
+		{
+			fclose( DestP );
+			return -1;
+		}
+	}
+
+	// ファイルを閉じる
+	fclose( DestP );
+
+	//////////////////////////////
+	///// Remove Unpack Protection
+	const std::vector<std::wstring> UNPACK_PROTECTION_FILES = { L"game.dat", L"cdatabase.dat", L"database.dat", L"commonevent.dat" };
+	const uint8_t ANTI_UNPACK_DATA[62]                      = { 0x45, 0x78, 0x74, 0x72, 0x61, 0x63, 0x74, 0x69, 0x6E, 0x67, 0x20, 0x64, 0x61, 0x74, 0x61, 0x20, 0x66, 0x72, 0x6F, 0x6D, 0x20, 0x65, 0x6E, 0x63, 0x72, 0x79, 0x70, 0x74, 0x65, 0x64, 0x20, 0x66, 0x69, 0x6C, 0x65, 0x73, 0x20, 0x76, 0x69, 0x6F, 0x6C, 0x61, 0x74, 0x65, 0x73, 0x20, 0x74, 0x68, 0x65, 0x20, 0x67, 0x75, 0x69, 0x64, 0x65, 0x6C, 0x69, 0x6E, 0x65, 0x73, 0x2E, 0x00 };
+	const uint32_t ANTI_UNPACK_DATA_SIZE                    = 62;
+
+	TCHAR *pBareName = DXA_RawNameToTCHAR( Record.Name, Record.NameBytes );
+
+	std::wstring fileName = std::wstring( pBareName );
+	std::transform( fileName.begin(), fileName.end(), fileName.begin(), ::tolower );
+
+	// As I am not sure if the file name will contain only the actual file name or also a directory
+	// check if the file name ends with any of the unpack protection files
+	bool isUnpackProtectionFile = false;
+
+	for( const std::wstring &unpackProtectionFile : UNPACK_PROTECTION_FILES )
+	{
+		if( fileName.ends_with( unpackProtectionFile ) )
+		{
+			isUnpackProtectionFile = true;
+			break;
+		}
+	}
+
+	delete[] pBareName;
+
+	if( isUnpackProtectionFile )
+	{
+		TCHAR *pProtectName = DXA_RawNameToTCHAR( Record.Path, Record.PathBytes );
+
+		DestP = _tfopen( pProtectName, TEXT("rb") );
+
+		// Get the file size
+		_fseeki64( DestP, 0, SEEK_END );
+		int64_t fileSize = _ftelli64( DestP );
+
+		if( fileSize >= ANTI_UNPACK_DATA_SIZE )
+		{
+			// Check if the file begins with the anti-unpack data
+			_fseeki64( DestP, 0, SEEK_SET );
+
+			void *pFileBeginning = malloc( ANTI_UNPACK_DATA_SIZE );
+			fread64( pFileBeginning, ANTI_UNPACK_DATA_SIZE, DestP );
+
+			if( pFileBeginning && std::memcmp( pFileBeginning, ANTI_UNPACK_DATA, ANTI_UNPACK_DATA_SIZE ) == 0 )
+			{
+				fileSize -= ANTI_UNPACK_DATA_SIZE;
+
+				// Remove the first 62 bytes from the file
+				_fseeki64( DestP, ANTI_UNPACK_DATA_SIZE, SEEK_SET );
+
+				std::vector<uint8_t> buffer( fileSize );
+				fread64( buffer.data(), fileSize, DestP );
+				fclose( DestP );
+
+				DestP = _tfopen( pProtectName, TEXT("wb") );
+
+				fwrite64( buffer.data(), fileSize, DestP );
+			}
+
+			free( pFileBeginning );
+		}
+
+		fclose( DestP );
+
+		delete[] pProtectName;
+	}
+
+	///// Remove Unpack Protection
+	//////////////////////////////
+
+	// ファイルのタイムスタンプを設定する
+	{
+		HANDLE HFile;
+		FILETIME CreateTime, LastAccessTime, LastWriteTime;
+		TCHAR *pTimeName = DXA_RawNameToTCHAR( Record.Path, Record.PathBytes );
+		HFile        = CreateFile( pTimeName,
+								  GENERIC_WRITE, 0, NULL,
+								  OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, NULL );
+		delete[] pTimeName;
+
+		CreateTime.dwHighDateTime     = (u32)( File->Time.Create >> 32 );
+		CreateTime.dwLowDateTime      = (u32)( File->Time.Create & 0xffffffffffffffff );
+		LastAccessTime.dwHighDateTime = (u32)( File->Time.LastAccess >> 32 );
+		LastAccessTime.dwLowDateTime  = (u32)( File->Time.LastAccess & 0xffffffffffffffff );
+		LastWriteTime.dwHighDateTime  = (u32)( File->Time.LastWrite >> 32 );
+		LastWriteTime.dwLowDateTime   = (u32)( File->Time.LastWrite & 0xffffffffffffffff );
+		SetFileTime( HFile, &CreateTime, &LastAccessTime, &LastWriteTime );
+		CloseHandle( HFile );
+	}
+
+	// ファイル属性を付ける
+	{
+		TCHAR *pAttrName = DXA_RawNameToTCHAR( Record.Path, Record.PathBytes );
+		SetFileAttributes( pAttrName, (u32)File->Attributes & ~( FILE_ATTRIBUTE_SYSTEM | FILE_ATTRIBUTE_HIDDEN ) );
+		delete[] pAttrName;
+	}
+
+	return 0;
+}
