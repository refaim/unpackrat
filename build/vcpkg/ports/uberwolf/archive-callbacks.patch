+// アラインされていない可能性のあるメタデータから整数を読み取る
+static u64 DXA_LoadU64( const u8 *p )
+{
+	u64 v;
+	memcpy( &v, p, sizeof( v ) );
+	return v;
+}
+
+static u16 DXA_LoadU16( const u8 *p )
+{
+	u16 v;
+	memcpy( &v, p, sizeof( v ) );
+	return v;
+}
+
+// 生の符号化ファイル名レコードを検証し、原ケースコピーの NUL 終端までの長さを返す。
+// NameRegionSize は名前テーブル領域の長さ( メタデータ全体ではない )。
+static int DXA_ValidateNameRecord( const u8 *NameP, u64 NameRegionSize, u64 NameAddress, const u8 **NameOut, size_t *NameBytesOut )
+{
+	// ファイル名は 4 バイトブロック単位で配置される
+	if( ( NameAddress % 4 ) != 0 ) return -1;
+	if( NameAddress > NameRegionSize || NameRegionSize - NameAddress < 4 ) return -1;
+
+	const u64 PackNum = (u64)DXA_LoadU16( NameP + NameAddress );
+	const u64 Copies  = PackNum * 4;
+	const u64 RecordSize = 4 + Copies * 2;
+	if( RecordSize > NameRegionSize - NameAddress ) return -1;
+
+	if( PackNum == 0 )
+	{
+		*NameOut = NULL;
+		*NameBytesOut = 0;
+		return 0;
+	}
+
+	const u8 *Upper    = NameP + NameAddress + 4;
+	const u8 *Original = Upper + Copies;
+
+	// 大文字コピー・原ケースコピーの双方に範囲内の NUL 終端が必須
+	int UpperTerminated = 0;
+	for( u64 i = 0; i < Copies; i++ )
+	{
+		if( Upper[ i ] == 0 ) { UpperTerminated = 1; break; }
+	}
+	if( !UpperTerminated ) return -1;
+
+	size_t NameBytes = 0;
+	int OriginalTerminated = 0;
+	for( u64 i = 0; i < Copies; i++ )
+	{
+		if( Original[ i ] == 0 ) { NameBytes = (size_t)i; OriginalTerminated = 1; break; }
+	}
+	if( !OriginalTerminated ) return -1;
+
+	*NameOut = Original;
+	*NameBytesOut = NameBytes;
+	return 0;
+}
+
+// 生の符号化バイト列( コードページ 932 )を TCHAR 文字列へ変換する
+static TCHAR *DXA_RawNameToTCHAR( const u8 *Raw, size_t RawBytes )
+{
+	int Need = 0;
+	if( RawBytes != 0 )
+	{
+		Need = MultiByteToWideChar( GLOBAL_CHAR_CODE, 0, reinterpret_cast<LPCCH>( Raw ), (int)RawBytes, NULL, 0 );
+		if( Need < 0 ) Need = 0;
+	}
+	TCHAR *Out = new TCHAR[ (size_t)Need + 1 ]();
+	if( Need > 0 )
+	{
+		MultiByteToWideChar( GLOBAL_CHAR_CODE, 0, reinterpret_cast<LPCCH>( Raw ), (int)RawBytes, Out, Need );
+	}
+	Out[ Need ] = 0;
+	return Out;
+}
