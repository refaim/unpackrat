+// Snapshot the operation cipher from the header's crypt version and the process-wide key
+// material the caller has already set up (the exact values DXArchive::KeyConv would read). The
+// classic branch keeps the archive key, modern keeps the derived 768-byte key and version, and
+// ChaCha20 keeps the key/nonce pair.
+static void DXA_SnapshotOperationCipher( DXA_OPERATION_CIPHER &Operation, uint16_t CryptVersion, const u8 *ClassicKey )
+{
+	Operation = DXA_OPERATION_CIPHER{};
+	Operation.CryptVersion = CryptVersion;
+	if( ClassicKey != nullptr ) memcpy( Operation.Classic.Key, ClassicKey, DXA_KEY_BYTES );
+
+	if( ( CryptVersion >= 331 && CryptVersion < 1000 ) || CryptVersion >= 1010 )
+	{
+		Operation.Kind = DXA_CIPHER_MODERN;
+		memcpy( Operation.SpecialKey, g_specialKey, sizeof( Operation.SpecialKey ) );
+	}
+	else if( CryptVersion == 0x64 || CryptVersion == 0xC8 )
+	{
+		Operation.Kind = DXA_CIPHER_CHACHA;
+		memcpy( Operation.Cc20Key, g_cc20Key, sizeof( Operation.Cc20Key ) );
+		memcpy( Operation.Cc20Nonce, g_cc20Nonce, sizeof( Operation.Cc20Nonce ) );
+	}
+	else
+	{
+		Operation.Kind = DXA_CIPHER_CLASSIC;
+	}
+}
