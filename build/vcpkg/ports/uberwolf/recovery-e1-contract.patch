+
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <exception>
+
+// Raised when a bounded metadata read has charged more traversal units than the session allows.
+// It derives from std::exception rather than WolfRPGException on purpose: a caller has to be able
+// to classify an over-budget image separately from a structurally malformed one, and an accidental
+// catch of WolfRPGException must never swallow a budget failure.
+class WolfReadUnitBudgetExceeded : public std::exception
+{
+};
+
+// Raised by the bounded read dispatch when an image uses a protected or compressed format this
+// phase does not decode. It derives from std::exception rather than WolfRPGException on purpose: a
+// caller has to tell "unsupported in this phase" apart from "malformed", and an accidental catch of
+// WolfRPGException must never reclassify a capability gap as a corrupt image.
+class WolfRPGUnsupportedException : public std::exception
+{
+public:
+	explicit WolfRPGUnsupportedException(const char* pWhat) :
+		m_what(pWhat)
+	{
+	}
+
+	const char* what() const noexcept override
+	{
+		return m_what;
+	}
+
+private:
+	const char* m_what;
+};
+
+// Raised when a bounded decode would grow the in-memory image past the session's expanded-byte
+// budget. Like the two exceptions above it derives from std::exception rather than WolfRPGException
+// so a budget failure can never be relabelled as a malformed image by an unrelated catch.
+class WolfRPGExpandedBudgetExceeded : public std::exception
+{
+};
+
+// Per-image read context for the bounded metadata collector. The original reader kept the format
+// flags in process-wide statics (FileCoder::s_isUTF8, FileCoder::s_projKey, Command::s_v35) and a
+// global active file. That is fine for the whole-game writer flow, but a metadata collector parses
+// several independent images, so this context carries the same flags per image and lets a bounded
+// load run without reading or writing any of those statics. It also owns the shared session
+// traversal-unit counter so a hostile archive cannot drive an unbounded element loop.
+class WolfReadContext
+{
+public:
+	// The shared unit counter and its cap are bound once at construction, so a context is always
+	// backed by a live session counter and ChargeUnit never has to handle an unbound state.
+	WolfReadContext(std::size_t& totalUnits, const std::size_t maxUnits) noexcept :
+		m_units(totalUnits),
+		m_maxUnits(maxUnits)
+	{
+	}
+
+	// Per-image format flags. ResetImage() restores the classic defaults before each parse.
+	bool isUTF8           = false;
+	std::uint32_t projKey = 0xFFFFFFFFU; // the original -1 "unset" sentinel
+	bool v35              = false;
+
+	void ResetImage() noexcept
+	{
+		isUTF8  = false;
+		v35     = false;
+		projKey = 0xFFFFFFFFU;
+	}
+
+	// Charge one traversal unit before visiting one collection element. The guard runs before the
+	// increment, so the charged total never exceeds the maximum: a partially traversed image keeps
+	// the units it already charged and the caller's counter stays at or below the cap.
+	void ChargeUnit()
+	{
+		if (m_units >= m_maxUnits)
+			throw WolfReadUnitBudgetExceeded();
+
+		++m_units;
+	}
+
+	// Bind the shared expanded-byte counter and its per-image / cumulative caps. A context that is
+	// never bound still enforces the finite defaults below, so a bounded decode can never allocate an
+	// unbounded buffer.
+	void ConfigureExpanded(std::size_t& totalExpandedBytes, const std::size_t maxImageExpandedBytes, const std::size_t maxTotalExpandedBytes) noexcept
+	{
+		m_expanded              = &totalExpandedBytes;
+		m_maxImageExpandedBytes = maxImageExpandedBytes;
+		m_maxTotalExpandedBytes = maxTotalExpandedBytes;
+	}
+
+	// Charge ``bytes`` of decoded output before the decoded buffer is allocated. The per-image cap
+	// and the cumulative cap run first, so a rejected decode charges nothing and a malformed or
+	// retried image can never refund bytes an earlier decode already charged. This is the only place
+	// the cumulative counter is advanced, so it never exceeds its cap and the subtraction cannot
+	// underflow.
+	void ChargeExpanded(const std::size_t bytes)
+	{
+		if (bytes > m_maxImageExpandedBytes)
+			throw WolfRPGExpandedBudgetExceeded();
+
+		if (bytes > m_maxTotalExpandedBytes - *m_expanded)
+			throw WolfRPGExpandedBudgetExceeded();
+
+		*m_expanded += bytes;
+	}
+
+private:
+	std::size_t& m_units;
+	std::size_t m_maxUnits = 0;
+
+	std::size_t m_localExpanded            = 0;
+	std::size_t* m_expanded                = &m_localExpanded;
+	std::size_t m_maxImageExpandedBytes    = 128U * 1024U * 1024U;
+	std::size_t m_maxTotalExpandedBytes    = 512U * 1024U * 1024U;
+};
