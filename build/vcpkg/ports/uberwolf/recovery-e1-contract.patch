+ *  AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
+ *  LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,
+ *  OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE
+ *  SOFTWARE.
+ *
+ */
+
+#include "GameContext.hpp"
+
+#include "Utils.h"
+#include "WolfUtils.h"
+
+#include <filesystem>
+
+namespace fs = std::filesystem;
+
+namespace
+{
+	const tStrings GAME_EXE_NAMES = {
+		TEXT("Game.exe"),
+		TEXT("GamePro.exe")
+	};
+
+	const tString DATA_FOLDER_NAME = TEXT("Data");
+}
+
+namespace wolf::game
+{
+	const tStrings& GameExecutableNames()
+	{
+		return GAME_EXE_NAMES;
+	}
+
+	const tString& DataFolderName()
+	{
+		return DATA_FOLDER_NAME;
+	}
+
+	tString ExecutableSearchFolder(const tString& archivePath)
+	{
+		// Get the folder containing the archive
+		tString searchFolder = FS_PATH_TO_TSTRING(fs::path(archivePath).parent_path());
+
+		// If the search folder is the data folder, search for the game executable one level up
+		if (fs::path(searchFolder).filename() == DataFolderName())
+			searchFolder = FS_PATH_TO_TSTRING(fs::path(searchFolder).parent_path());
+
+		return searchFolder;
+	}
+
+	tString FindGameExecutable(const tString& searchFolder)
+	{
+		for (const auto& gameExeName : GameExecutableNames())
+		{
+			const tString gameExePath = searchFolder + TEXT("/") + gameExeName;
+			if (fs::exists(gameExePath))
+				return gameExePath;
+		}
+
+		return TEXT("");
+	}
+
+	bool FindDataFolder(const tString& gameFolder, tString& dataFolder, bool& dataInBaseFolder)
+	{
+		dataInBaseFolder = false;
+
+		// First check if data.EXT exists in the game folder -- because after unpacking the data
+		// folder will exist but contain the wrong files
+		if (ExistsWolfDataFile(gameFolder))
+		{
+			dataInBaseFolder = true;
+			dataFolder       = gameFolder;
+			return true;
+		}
+
+		// Check if the data folder exists
+		if (fs::exists(gameFolder + TEXT("/") + DataFolderName()))
+		{
+			dataFolder = gameFolder + TEXT("/") + DataFolderName();
+			return true;
+		}
+
+		return false;
+	}
+
+	tString FindCompanionFile(const tString& dataFolder)
+	{
+		// Check if the data folder contains any of the DxArc key files
+		for (const tString& file : GetSpecialFiles())
+		{
+			const tString filePath = dataFolder + TEXT("/") + file;
+			if (fs::exists(filePath))
+				return filePath;
+		}
+
+		return TEXT("");
+	}
+
+	Context ResolveFromExecutable(const tString& executablePath)
+	{
+		Context context;
+
+		try
+		{
+			if (!fs::exists(executablePath))
+				return context;
+
+			tString gameExePath = executablePath;
+
+			if (fs::path(gameExePath).parent_path().empty())
+				gameExePath = FS_PATH_TO_TSTRING(fs::current_path()) + TEXT("/") + gameExePath;
+
+			context.executablePath = gameExePath;
+			context.gameFolder     = FS_PATH_TO_TSTRING(fs::path(gameExePath).parent_path());
+
+			if (!FindDataFolder(context.gameFolder, context.dataFolder, context.dataInBaseFolder))
+				return context;
+
+			context.companionFile = FindCompanionFile(context.dataFolder);
+			context.status = context.companionFile.empty() ? ContextStatus::MissingCompanion : ContextStatus::Resolved;
+		}
+		catch (const fs::filesystem_error&)
+		{
+			// A probe failed instead of reporting a simple absence. The fields resolved before the
+			// failure are kept, so the caller still gets the best answer the search produced.
+			context.status = ContextStatus::IoFailure;
+			return context;
+		}
+
+		return context;
+	}
+
+	Context ResolveFromArchive(const tString& archivePath)
+	{
+		try
+		{
+			return ResolveFromExecutable(FindGameExecutable(ExecutableSearchFolder(archivePath)));
+		}
+		catch (const fs::filesystem_error&)
+		{
+			// The executable search can fail before ResolveFromExecutable runs, so the whole
+			// operation is guarded and reports the same I/O failure instead of letting the error
+			// escape to the caller.
+			Context failure;
+			failure.status = ContextStatus::IoFailure;
+			return failure;
+		}
+	}
+}
