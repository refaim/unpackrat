new file mode 100644
index 0000000..5b9c894
--- /dev/null
+++ b/UberWolfLib/Archive/BoundedLz.hpp
@@ -0,0 +1,262 @@
+/*
+ *  File: BoundedLz.hpp
+ *
+ *  Bounded, resumable interpreter of the DXLib/WolfRPG LZ token stream. This is the single
+ *  implementation of the token grammar: the pinned DXArchive::Decode compatibility path drives
+ *  it over one contiguous output buffer, and the unpackrat Wolf RPG reader drives it over a
+ *  bounded history ring and a caller-owned output chunk. Nothing here allocates, and every
+ *  operand read, back-reference and emitted byte is bounded by the encoded and decoded extents
+ *  supplied by the caller.
+ *
+ *  Vendor-only header: included from the pinned DXArchive.cpp translation unit and from the
+ *  unpackrat WolfRPG adapter implementation; it is not part of the public unpackrat API.
+ */
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <functional>
+#include <optional>
+#include <span>
+#include <stdexcept>
+#include <utility>
+
+namespace wolf::archive::boundedlz
+{
+    // The encoded region always opens with this 9-byte header: a u32 decoded size, a u32 total
+    // encoded size (header included) and a u8 key code.
+    inline constexpr std::uint64_t header_size = 9;
+
+    // The widest back-reference address field is 24 bits and the stored value is biased by one,
+    // so a distance is at most 16 MiB. The three-byte little-endian read below caps the field
+    // structurally at that width; the produced-byte bound is the live guard.
+    inline constexpr std::uint64_t max_distance = 16ull * 1024ull * 1024ull;
+
+    // The stored back-reference length is reduced by this minimum on encode.
+    inline constexpr std::uint64_t min_compress = 4;
+
+    // Largest buffered encoded span; the source never sees a request larger than this.
+    inline constexpr std::size_t input_buffer_size = 64;
+
+    // Raised for a structurally invalid stream, a short source, or an encoded region that does
+    // not decode to exactly the declared output extent. No other exception type is raised here;
+    // a failing source propagates its own exception unchanged.
+    class error final : public std::runtime_error
+    {
+      public:
+        using std::runtime_error::runtime_error;
+    };
+
+    // Per-byte emission callbacks. ``read`` returns the already produced decoded byte at the
+    // absolute position passed in; ``write`` appends the next produced decoded byte. The kernel
+    // invokes them in increasing position order and lets any exception escape unchanged.
+    struct emitter
+    {
+        std::byte (*read)(void *context, std::uint64_t position);
+        void (*write)(void *context, std::byte value);
+        void *context;
+    };
+
+    // Reads and validates the 9-byte header, then decodes on demand.
+    class context
+    {
+      public:
+        // Sequential encoded-byte source. Fills up to destination.size() bytes and returns the
+        // number written; zero means the source has no more bytes. The context never requests
+        // more than the remaining encoded extent.
+        using source = std::function<std::size_t(std::span<std::byte> destination)>;
+
+        // encoded_extent is the exact number of encoded bytes (header included); decoded_extent
+        // is the exact number of decoded bytes. Both header-declared sizes must match them.
+        context(source input, std::uint64_t encoded_extent, std::uint64_t decoded_extent)
+            : input_(std::move(input)), encoded_extent_(encoded_extent), decoded_extent_(decoded_extent)
+        {
+            if (encoded_extent_ < header_size) {
+                throw error("encoded extent is smaller than the 9-byte header");
+            }
+
+            const std::uint64_t declared_output = next_uint(4);
+            const std::uint64_t declared_encoded = next_uint(4);
+            key_ = byte_count(next_byte());
+
+            if (declared_output != decoded_extent_) {
+                throw error("declared output size does not match the requested output size");
+            }
+            if (declared_encoded != encoded_extent_) {
+                throw error("declared encoded size does not match the requested encoded size");
+            }
+            if (decoded_extent_ == 0 && encoded_extent_ != header_size) {
+                throw error("zero-output stream has trailing encoded bytes");
+            }
+        }
+
+        context(const context &) = delete;
+        context &operator=(const context &) = delete;
+        context(context &&) noexcept = default;
+        context &operator=(context &&) noexcept = default;
+        ~context() = default;
+
+        // Produces up to count decoded bytes through ``sink`` and returns how many were written.
+        // Zero once the whole decoded extent is produced, so callers drive the stream with
+        // ``while (produce(n, sink) != 0)``.
+        std::size_t produce(std::size_t count, const emitter &sink)
+        {
+            std::size_t written = 0;
+            while (written < count && produced_ < decoded_extent_) {
+                if (copy_remaining_ == 0) {
+                    begin_unit();
+                }
+                if (copy_remaining_ != 0) {
+                    sink.write(sink.context, sink.read(sink.context, produced_ - copy_distance_));
+                    --copy_remaining_;
+                } else {
+                    const std::byte value = literal_.value();
+                    literal_.reset();
+                    sink.write(sink.context, value);
+                }
+                ++produced_;
+                ++written;
+            }
+            if (produced_ == decoded_extent_) {
+                finish();
+            }
+            return written;
+        }
+
+        [[nodiscard]] std::uint64_t remaining() const noexcept { return decoded_extent_ - produced_; }
+        [[nodiscard]] std::uint64_t produced() const noexcept { return produced_; }
+        [[nodiscard]] std::uint64_t decoded_extent() const noexcept { return decoded_extent_; }
+        [[nodiscard]] std::uint64_t encoded_extent() const noexcept { return encoded_extent_; }
+        [[nodiscard]] std::uint8_t key() const noexcept { return key_; }
+        [[nodiscard]] bool finished() const noexcept { return produced_ == decoded_extent_; }
+
+      private:
+        static constexpr std::uint8_t byte_count(const std::byte value) noexcept
+        {
+            return std::to_integer<std::uint8_t>(value);
+        }
+
+        // Ensures a buffered encoded byte is available. Returns false only at the exact end of
+        // the encoded extent, so callers can tell "no more bytes exist" from a truncated token.
+        bool fill()
+        {
+            if (buffer_position_ < buffer_length_) {
+                return true;
+            }
+            if (fetched_ >= encoded_extent_) {
+                return false;
+            }
+            const std::uint64_t want = std::min<std::uint64_t>(
+                static_cast<std::uint64_t>(buffer_.size()), encoded_extent_ - fetched_);
+            const std::size_t got = input_(std::span<std::byte>(buffer_).first(static_cast<std::size_t>(want)));
+            if (got > static_cast<std::size_t>(want)) {
+                throw error("encoded source returned more bytes than requested");
+            }
+            if (got == 0) {
+                throw error("encoded source ended before the declared encoded size");
+            }
+            buffer_position_ = 0;
+            buffer_length_ = got;
+            fetched_ += got;
+            return true;
+        }
+
+        std::byte next_byte()
+        {
+            if (!fill()) {
+                throw error("encoded stream ended inside a token");
+            }
+            const std::byte value = buffer_[buffer_position_];
+            ++buffer_position_;
+            ++consumed_;
+            return value;
+        }
+
+        // Reads a little-endian unsigned value of 1..3 bytes without an unaligned cast.
+        std::uint64_t next_uint(unsigned count)
+        {
+            std::uint64_t value = 0;
+            for (unsigned index = 0; index < count; ++index) {
+                value |= static_cast<std::uint64_t>(byte_count(next_byte())) << (8u * index);
+            }
+            return value;
+        }
+
+        // Decodes one token into either a pending literal byte or a pending back-reference. Every
+        // operand read is bounded by the encoded extent through next_byte, and every back-
+        // reference is bounded by the produced bytes and the declared decoded extent.
+        void begin_unit()
+        {
+            const std::byte first = next_byte();
+            if (first != static_cast<std::byte>(key_)) {
+                literal_ = first;
+                return;
+            }
+
+            const std::byte second = next_byte();
+            if (second == static_cast<std::byte>(key_)) {
+                literal_ = second;
+                return;
+            }
+
+            std::uint32_t code = byte_count(second);
+            if (code > static_cast<std::uint32_t>(key_)) {
+                --code;
+            }
+            std::uint64_t length = code >> 3;
+            if ((code & 0x4u) != 0u) {
+                length |= static_cast<std::uint64_t>(byte_count(next_byte())) << 5;
+            }
+            length += min_compress;
+
+            std::uint64_t distance = 0;
+            switch (code & 0x3u) {
+            case 0u:
+                distance = next_uint(1);
+                break;
+            case 1u:
+                distance = next_uint(2);
+                break;
+            case 2u:
+                distance = next_uint(3);
+                break;
+            default:
+                throw error("reserved back-reference distance width");
+            }
+            ++distance;
+
+            if (distance > produced_) {
+                throw error("back-reference points before the start of the output");
+            }
+            if (length > decoded_extent_ - produced_) {
+                throw error("back-reference overruns the declared output size");
+            }
+            copy_distance_ = distance;
+            copy_remaining_ = length;
+        }
+
+        // Confirms the whole encoded extent was consumed once the output is complete.
+        void finish()
+        {
+            if (consumed_ != encoded_extent_) {
+                throw error("encoded stream has unread bytes after the output was produced");
+            }
+        }
+
+        source input_;
+        std::array<std::byte, input_buffer_size> buffer_{};
+        std::uint64_t encoded_extent_ = 0;
+        std::uint64_t decoded_extent_ = 0;
+        std::uint64_t fetched_ = 0;
+        std::uint64_t consumed_ = 0;
+        std::uint64_t produced_ = 0;
+        std::size_t buffer_position_ = 0;
+        std::size_t buffer_length_ = 0;
+        std::uint64_t copy_distance_ = 0;
+        std::uint64_t copy_remaining_ = 0;
+        std::optional<std::byte> literal_;
+        std::uint8_t key_ = 0;
+    };
+} // namespace wolf::archive::boundedlz
