@@ -0,0 +1,47 @@
+/*
+ *  File: ClassicContext.hpp
+ *
+ *  The classic Wolf RPG DX archive key transform as one pure, globals-free kernel.
+ *
+ *  DXArchive::KeyConv dispatches on the process-wide crypt-mode flags (g_newCrypt,
+ *  g_chacha20, g_cryptVersion) before it reaches its classic 7-byte XOR loop, so every
+ *  caller that goes through KeyConv inherits whatever mode another part of the process last
+ *  selected. This header isolates the classic branch: the pinned DXArchive::KeyConv classic
+ *  path and the unpackrat Wolf RPG adapter both call apply_key_xor, which depends only on the
+ *  explicit key bytes and the caller-supplied phase, never on library-wide state.
+ *
+ *  Vendor-only header: included from the pinned DXArchive.cpp translation unit and from the
+ *  unpackrat WolfRPG adapter implementation; it is not part of the public unpackrat API.
+ */
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <span>
+
+namespace wolf::archive::classic
+{
+    // The classic archive key length in bytes (DXLib DXA_KEY_BYTES).
+    inline constexpr std::size_t key_bytes = 7;
+
+    // Applies the classic 7-byte key XOR in place over ``data``. ``phase`` selects the key byte
+    // for the first element and must already be reduced modulo ``key_bytes``. The transform is a
+    // pure function of ``key`` and ``phase``: it reads no global mode flag, allocates nothing and
+    // never advances past ``data``.
+    inline void apply_key_xor(std::span<std::byte> data, std::size_t phase,
+                              std::span<const unsigned char, key_bytes> key) noexcept
+    {
+        std::size_t index = phase;
+
+        for (std::byte &value : data)
+        {
+            value ^= static_cast<std::byte>(key[index]);
+
+            ++index;
+            if (index == key_bytes)
+            {
+                index = 0;
+            }
+        }
+    }
+} // namespace wolf::archive::classic
