+/*
+ *  File: BorrowedRead.hpp
+ *
+ *  The single bounded reader over a borrowed, caller-owned byte image ( std::span<const std::byte> ).
+ *
+ *  The two memory entry points of the pinned DXLib DXArchive ( OpenArchiveFileMem and OpenArchiveMem )
+ *  each adapt a lazily-read byte image to DXArchive::Source::read_at by validating an ( offset, size )
+ *  request against the image length and then copying the bytes out. That validate-and-copy pair used to
+ *  be duplicated verbatim in both adapters; this header owns the one implementation they now share, so
+ *  the bounds contract can only drift in one place.
+ *
+ *  Contract ( preserved byte for byte from both former adapters ):
+ *    * A zero-length destination always succeeds and is answered before the offset is examined, so a
+ *      caller may probe an image with size 0 regardless of the offset.
+ *    * Otherwise a negative offset, an offset past the image, or a requested length that overruns the
+ *      remaining image ( length > source.size() - offset ) is rejected before any byte is copied and
+ *      before the offset would be narrowed, so the caller's destination stays untouched.
+ *    * On success exactly destination.size() bytes are moved with memmove, which stays correct when the
+ *      borrowed source and the destination overlap.
+ *
+ *  Nothing here allocates, consults library state or exposes a vendor type; the bounds are expressed
+ *  with the standard library's span and fixed-width integers.
+ *
+ *  Vendor-only header: included from the pinned DXArchive.cpp translation unit and from the
+ *  unpackrat WolfRPG adapter implementation; it is not part of the public unpackrat API.
+ */
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <span>
+
+namespace wolf::archive::borrowed
+{
+    // Copies destination.size() bytes from source at offset into destination. Returns false, and leaves
+    // destination unchanged, when the request is not fully inside source; returns true otherwise.
+    inline bool read_at(std::span<const std::byte> source, std::int64_t offset,
+                        std::span<std::byte> destination) noexcept
+    {
+        // A zero-length request is always satisfiable and never inspects the offset.
+        if (destination.empty())
+        {
+            return true;
+        }
+
+        if (offset < 0)
+        {
+            return false;
+        }
+
+        const std::uint64_t start = static_cast<std::uint64_t>(offset);
+
+        // Reject an offset past the image and a length that overruns the remaining bytes before the
+        // offset is narrowed to size_t or a single byte is copied.
+        if (start > source.size() ||
+            source.size() - static_cast<std::size_t>(start) < destination.size())
+        {
+            return false;
+        }
+
+        std::memmove(destination.data(), source.data() + static_cast<std::size_t>(start),
+                     destination.size());
+        return true;
+    }
+} // namespace wolf::archive::borrowed
