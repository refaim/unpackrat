+// Operation-local cipher transform. It keeps the classic / modern / ChaCha20 order of
+// DXArchive::KeyConv but drives it from the snapshot, so metadata (logical position 0) and each
+// body (logical position DataSize) run through exactly the kernels the original KeyConv used.
+// 1 回分の呼び出しのビュー。共有カーネルのスナップショットと、この領域が始まった論理位置を持つ。
+// DXLib は元の呼び出しの絶対位置を 32bit へ「一度だけ」切り詰めてから呼び出し全体を走らせるので、
+// 断片は base + 呼び出し内オフセットで表さなければならない。断片ごとに絶対位置を切り詰め直すと
+// 2^32 を越える桁上げが失われる。
+struct DXA_OPERATION_CALL
+{
+	const DXA_OPERATION_CIPHER *Operation;
+	u64                         CallBase;
+};
+
+static void DXA_OperationTransform( void *Context, void *Data, size_t Size, u64 Position )
+{
+	DXA_OPERATION_CALL *Call = static_cast<DXA_OPERATION_CALL *>( Context );
+	const DXA_OPERATION_CIPHER *Operation = Call->Operation;
+
+	// Both call sites arm this adaptor only with a caller-built snapshot ( a non-null Operation
+	// whose Kind is MODERN, CHACHA or CLASSIC ) and only ever deliver a non-empty slice
+	// ( DXA_SOURCE_READER::Read returns early on Size == 0 ), so the arm is the only fact this
+	// dispatch needs. MODERN and CHACHA select their kernels and CLASSIC is the remaining arm;
+	// the classic key is applied through the same operation-local kernel the metadata path uses.
+	if( Operation->Kind == DXA_CIPHER_MODERN )
+	{
+		wolf::crypt::wolfCrypt( Operation->SpecialKey, static_cast<uint8_t *>( Data ),
+			(s64)Position, (s64)( Position + Size ), false, Operation->CryptVersion );
+	}
+	else if( Operation->Kind == DXA_CIPHER_CHACHA )
+	{
+		uint32_t state[ 16 ];
+		uint32_t keystream32[ 16 ];
+		std::memset( state, 0, sizeof( state ) );
+		std::memset( keystream32, 0, sizeof( keystream32 ) );
+		wolf::crypt::chacha20::initBlock( state, Operation->Cc20Key, Operation->Cc20Nonce );
+		// The whole-call base is truncated to 32 bits once, the way the original single call was;
+		// the within-call offset keeps its full 64-bit width, so a body whose logical start is below
+		// 2^32 still decrypts correctly when a later pull steps past it.
+		wolf::crypt::chacha20::applyCallRange( state, keystream32, (uint32_t)Call->CallBase,
+			Position - Call->CallBase, static_cast<uint8_t *>( Data ), (uint64_t)Size );
+	}
+	else
+	{
+		DXA_ClassicTransform( const_cast<DXA_CLASSIC_KEY *>( &Operation->Classic ), Data, Size, Position );
+	}
+}
