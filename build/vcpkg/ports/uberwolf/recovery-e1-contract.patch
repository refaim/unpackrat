+ *  LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,
+ *  OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE
+ *  SOFTWARE.
+ *
+ */
+
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <numeric>
+#include <span>
+#include <vector>
+
+#include "../WolfCrypt/ModernContext.hpp"
+#include "../WolfCrypt/WolfAes.hpp"
+#include "../WolfCrypt/WolfCrypt.hpp"
+#include "../WolfCrypt/WolfCryptTypes.hpp"
+#include "../WolfCrypt/WolfRng.hpp"
+
+// Shared DxArc companion-key kernels.
+//
+// Wolf RPG Pro derives its DxArc key one of three ways from the companion file, selected by the
+// companion's first byte. The variant-1 and variant-2 derivations live here once: the pinned
+// whole-buffer entry points (WolfPro::findDxArcKeyV1 and wolf::crypt::dxarckey::v2::calcKey) and
+// the unpackrat sparse reader both drive these kernels, so the LCG stream, the AES-CTR seek, the
+// remainder search and the key assembly exist in exactly one place. Every kernel takes a caller
+// callback, so the caller decides whether the companion arrives whole or byte by byte. The RNG and
+// AES primitives themselves are the pinned header-only wolf::crypt helpers (an operation-local
+// rng::MsvcLcg, and the nonstandard schedule and range cipher in WolfAes.hpp); nothing here
+// re-implements a cipher, counter or RNG recurrence.
+namespace wolf::crypt::dxarckey
+{
+namespace v1
+{
+inline constexpr uint32_t SEED_OFFSET      = 4;
+inline constexpr uint32_t KEY_LEN_OFFSET   = 19;
+inline constexpr uint32_t KEY_START_OFFSET = 30;
+inline constexpr uint32_t STEP_DIVISOR     = 0x58B1;
+inline constexpr uint32_t MIN_FILESIZE     = 0x5CB8;
+inline constexpr uint32_t SHIFT            = 12;
+inline constexpr uint32_t XOR_START_OFFSET = 20;
+
+// The variant-1 key stream. ``seed`` is companion byte 4 and ``keyLen`` companion byte 19; both sit
+// below XOR_START_OFFSET, so neither is itself decoded. The stream is the exact MSVC C-runtime LCG
+// the pinned srand(seed) / rand() sweep used, driven by an owned rng::MsvcLcg so a caller's
+// derivation never touches the process-global rand() stream. ``readRaw`` returns the raw companion
+// byte at a physical offset; the decoded byte there is that byte XOR the high bits of the
+// (offset - XOR_START_OFFSET)-th draw, reproduced by advancing the LCG once per physical offset
+// from XOR_START_OFFSET and capturing the positions the pinned sweep selected.
+template <class ReadRaw>
+inline std::vector<uint8_t> calcKey(const uint8_t &seed, const uint8_t &keyLen, ReadRaw &&readRaw)
+{
+	std::vector<uint8_t> key;
+
+	if (keyLen == 0)
+		return key;
+
+	key.reserve(keyLen);
+
+	rng::MsvcLcg lcg;
+	lcg.seed(seed);
+
+	const uint32_t steps = STEP_DIVISOR / keyLen;
+	uint32_t offset      = KEY_START_OFFSET;
+
+	for (uint32_t at = XOR_START_OFFSET; key.size() < keyLen; at++)
+	{
+		const uint8_t stream = static_cast<uint8_t>(lcg.next() >> SHIFT);
+
+		if (at == offset)
+		{
+			key.push_back(static_cast<uint8_t>(readRaw(at) ^ stream));
+			offset += steps;
+		}
+	}
+
+	return key;
+}
+
+// The pinned whole-buffer variant-1 entry: the same key over an in-memory companion.
+inline std::vector<uint8_t> calcKey(const std::vector<uint8_t> &byteData, const uint32_t &fileSize)
+{
+	if (fileSize < MIN_FILESIZE)
+		return {};
+
+	auto readRaw = [&byteData](const uint32_t &at) -> uint8_t { return byteData[at]; };
+
+	return calcKey(byteData[SEED_OFFSET], byteData[KEY_LEN_OFFSET], readRaw);
+}
+} // namespace v1
+
+namespace v2
+{
+inline constexpr uint32_t HEADER_SIZE      = 31;
+inline constexpr uint32_t KEY_START_OFFSET = 30;
+
+// The key material initCrypt derives from the companion size and its leading bytes.
+struct derived
+{
+	std::array<uint8_t, 4> keyBytes  = { 0 };
+	std::array<uint8_t, 4> seedBytes = { 0 };
+	uint32_t dataSize                = 0;
+	uint32_t seed1                   = 0;
+	uint32_t seed2                   = 0;
+};
+
+// The pinned initCrypt arithmetic, keyed only by the data size and the eight leading companion
+// bytes, so the whole-buffer and sparse paths share one derivation.
+inline derived initCrypt(const uint32_t &dataSize, const std::span<const uint8_t> &header)
+{
+	derived d;
+	d.dataSize = dataSize;
+
+	const uint32_t sizeDiv = dataSize / 3;
+
+	const uint32_t val1 = sizeDiv + 71 + (sizeDiv >> 31);
+	const uint32_t val2 = dataSize ^ 0x70;
+	const uint32_t val3 = dataSize % 1200 + 152;
+	const uint32_t val4 = dataSize + 2 * dataSize + 85;
+
+	d.keyBytes[0] = static_cast<uint8_t>(val4 ^ val1);
+	d.keyBytes[1] = static_cast<uint8_t>(val3 + val2);
+	d.keyBytes[2] = static_cast<uint8_t>(val2 - val4);
+	d.keyBytes[3] = static_cast<uint8_t>(val2 * val4);
+
+	d.seedBytes[0] = static_cast<uint8_t>(val1 + header[3]);
+	d.seedBytes[1] = static_cast<uint8_t>(val3 + header[7]);
+	d.seedBytes[2] = static_cast<uint8_t>(val2 + header[5]);
+	d.seedBytes[3] = static_cast<uint8_t>(val4 + header[6]);
+
+	d.seed1 = val1;
+	d.seed2 = val3;
+
+	return d;
+}
+
+// The expanded AES schedule (round key followed by the 16-byte IV) the companion's
+// [KEY_START_OFFSET, size - 1) region is CTR-decoded with. The chain, key schedule and range
+// cipher are the pinned wolf::crypt primitives, driven through the operation-local helpers in
+// ModernContext.hpp.
+inline aes::AesRoundKey aesSchedule(const derived &d)
+{
+	CryptData cd;
+	cd.dataSize  = d.dataSize;
+	cd.keyBytes  = d.keyBytes;
+	cd.seedBytes = d.seedBytes;
+	cd.seed1     = d.seed1;
+	cd.seed2     = d.seed2;
+
+	rng::RngData rd;
+
+	modern::runRngChain(rd, cd.seed1, cd.seed2);
+
+	aes::AesKey aesKey = { 0 };
+	aes::AesIV aesIv   = { 0 };
+
+	modern::aesKeyGen(cd, rd, aesKey, aesIv);
+
+	aes::AesRoundKey roundKey = { 0 };
+
+	aes::keyExpansion(roundKey.data(), aesKey.data());
+	std::copy(aesIv.begin(), aesIv.end(), roundKey.begin() + aes::KEY_EXP_SIZE);
+
+	return roundKey;
+}
+
+// The header-derived start of the remainder search, exactly as the pinned calcKey seeded it.
+inline int32_t initialK(const std::span<const uint8_t> &header)
+{
+	return header[4] + ((static_cast<uint16_t>(header[3]) * header[6]) & 0x3FF);
+}
+
+// The pinned remainder search: advance k until it is coprime with the data size. std::gcd is the
+// shared Euclidean step. The search terminates by 1291: k starts at or below 1278, and were none
+// of [k, 1291] coprime the consecutive primes 1279, 1283, 1289 and 1291 would each divide dataSize,
+// forcing dataSize >= 1279 * 1283 * 1289 * 1291 > INT32_MAX, which the variant-2 domain
+// (dataSize <= INT32_MAX) excludes.
+inline int32_t selectK(const int32_t &dataSize, int32_t k)
+{
+	while (std::gcd(dataSize, k) > 1)
+		k++;
+
+	return k;
+}
+
+// Assemble the variant-2 key: keyLen positions selected at (i * k) % dataSize + KEY_START_OFFSET +
+// header[7], a 0x00 separator, then the four dynamic key bytes. ``readSelected`` returns the
+// decoded companion byte at a physical offset; the caller applies the AES-CTR seek for the region
+// the pinned whole-buffer path decrypted in place.
+template <class ReadSelected>
+inline std::vector<uint8_t> calcKey(const derived &d, const std::span<const uint8_t> &header, ReadSelected &&readSelected)
+{
+	const uint8_t keyLen  = header[19];
+	const uint8_t header7 = header[7];
+	const int32_t k       = selectK(static_cast<int32_t>(d.dataSize), initialK(header));
+
+	std::vector<uint8_t> key;
+	key.reserve(static_cast<size_t>(keyLen) + 5);
+
+	for (uint32_t i = 0; i < keyLen; i++)
+	{
+		const uint32_t at = (i * static_cast<uint32_t>(k)) % d.dataSize + KEY_START_OFFSET + header7;
+		key.push_back(readSelected(at));
+	}
+
+	key.push_back(static_cast<uint8_t>(0x0));
+
+	for (const uint8_t &byte : d.keyBytes)
+		key.push_back(byte);
+
+	return key;
+}
+
+// The pinned whole-buffer variant-2 entry: the same key over an in-memory companion, decrypting
+// the [KEY_START_OFFSET, size - 1) region in a local copy exactly as the pinned path did. An input
+// that is not larger than the 31-byte header has no data region and yields an empty key.
+inline std::vector<uint8_t> calcKey(const std::vector<uint8_t> &gameDataBytes)
+{
+	if (gameDataBytes.size() <= HEADER_SIZE)
+		return {};
+
+	std::vector<uint8_t> data = gameDataBytes;
+
+	const uint32_t dataSize = static_cast<uint32_t>(data.size()) - HEADER_SIZE;
+
+	const derived d = initCrypt(dataSize, data);
+
+	aes::AesRoundKey roundKey = aesSchedule(d);
+
+	aes::aesCtrXCrypt(data.data() + KEY_START_OFFSET, roundKey.data(), dataSize);
+
+	auto readSelected = [&data](const uint32_t &at) -> uint8_t { return data.at(at); };
+
+	return calcKey(d, data, readSelected);
+}
+} // namespace v2
+} // namespace wolf::crypt::dxarckey
