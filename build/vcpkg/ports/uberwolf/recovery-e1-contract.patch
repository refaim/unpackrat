+// Finds the byte offset of the first zero *code unit* that sits on a code-unit boundary, scanning
+// Copy in Unit-sized steps and never reading past Copies. Unit is the declared code page's
+// information unit (1 = S-JIS / UTF-8, 2 = UTF-16, 4 = UTF-32), so a lone 0x00 byte that is only
+// one half of a multi-byte unit is not mistaken for the terminator. Returns Copies when no aligned
+// zero unit is present.
+static u64 DXA_FindUnitTerminator( const u8 *Copy, u64 Copies, u64 Unit )
+{
+	u64 i = 0;
+	while( i + Unit <= Copies )
+	{
+		u64 AllZero = 1;
+		for( u64 b = 0; b < Unit; b++ )
+		{
+			if( Copy[ i + b ] != 0 ) { AllZero = 0; break; }
+		}
+		if( AllZero ) return i;
+		i += Unit;
+	}
+	return Copies;
+}
