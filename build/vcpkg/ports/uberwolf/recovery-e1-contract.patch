+// Operation-local crypt kernel selection. DXArchive::KeyConv (and the KeyConvFile* wrappers)
+// pick one of three kernels from process-wide flags: the modern WolfCrypt stream, ChaCha20, or
+// the classic 7-byte key XOR. The shared bounded metadata/body readers cannot consult those
+// globals, so the selected kernel and the key material it needs are snapshotted once per
+// operation; the transform below dispatches on the snapshot, and never on a process-global flag.
+enum DXA_CIPHER_KIND
+{
+	DXA_CIPHER_NONE    = 0,
+	DXA_CIPHER_CLASSIC = 1,
+	DXA_CIPHER_MODERN  = 2,
+	DXA_CIPHER_CHACHA  = 3
+};
+
+struct DXA_OPERATION_CIPHER
+{
+	int           Kind;
+	DXA_CLASSIC_KEY Classic;
+	unsigned char SpecialKey[ 768 ];
+	uint16_t      CryptVersion;
+	unsigned char Cc20Key[ 32 ];
+	unsigned char Cc20Nonce[ 12 ];
+};
