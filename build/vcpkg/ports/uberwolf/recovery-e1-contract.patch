+#pragma once
+
+// Streaming entry point for the WolfX key search and range decryption, added by the unpackrat
+// port patch. It is intentionally thin glue: the key search, the blob mixing and the checksum
+// sample validation all live once in detail/CrackDetail.hpp (and its scalar XOR in
+// detail/DataManipDetail.hpp), and the whole-buffer crackers drive that same code. This header
+// only adapts those shared helpers to a random-access reader over a stream, so a caller never
+// has to load the whole encrypted file. Upstream algorithms are not duplicated here.
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <string>
+
+// The pinned upstream headers carry their own unused-parameter/compound warnings. They are
+// vendored, not ours, so their diagnostics are muted only while their text is parsed; everything
+// below this block is our own code and stays under the full warning gate.
+#if defined(__clang__)
+#pragma clang diagnostic push
+#pragma clang diagnostic ignored "-Wunused-parameter"
+#pragma clang diagnostic ignored "-Wunused-variable"
+#endif
+#include "Types.hpp"
+#include "detail/CrackDetail.hpp"
+#include "detail/DataManipDetail.hpp"
+#if defined(__clang__)
+#pragma clang diagnostic pop
+#endif
+
+namespace wolfx::stream
+{
+	// The immutable result of a successful key/metadata search.
+	struct Plan
+	{
+		bool found = false;
+		DecryptBlob blob{};
+		std::uint64_t payloadOffset = 0;
+	};
+
+	// Plain XOR of an absolute byte range with a decrypt blob:
+	//   out[i] = in[i] ^ blob[(absoluteStart + i - 10) % 256]
+	// Requires absoluteStart >= 10; callers validate the range against the file size. The scalar
+	// transform is the shared detail::dataManip::xorByteWithBlob, which the whole-buffer path
+	// uses too, so the range and buffer XOR cannot drift apart.
+	inline void xorRange(const std::uint8_t *in, const std::size_t size, const std::uint64_t absoluteStart, const DecryptBlob &blob, std::uint8_t *out)
+	{
+		for (std::size_t i = 0; i < size; i++)
+			out[i] = detail::dataManip::xorByteWithBlob(in[i], blob, absoluteStart + i);
+	}
+
+	// Searches the candidate keys/strings/ints against a 20-byte header and the physical file
+	// size only. Sample bytes at the five checksum positions are pulled through ``readSample``
+	// (a random-access absolute-offset byte reader), so no file buffer is ever materialised. The
+	// search stops after ``maxAttempts`` blob validations. The search itself is the shared
+	// detail::crack::searchCollection used by the whole-buffer crackers.
+	template<class ReadSample>
+	inline Plan prepare(const std::array<std::uint8_t, 20> &header, const std::uint64_t physicalSize,
+						const WolfXDecryptCollection &candidates, ReadSample readSample, const std::uint64_t maxAttempts)
+	{
+		Plan plan;
+		DecryptBlob blob{};
+		std::uint64_t payloadOffset = 0;
+		if (detail::crack::searchCollection(header, physicalSize, candidates, maxAttempts, readSample, blob, payloadOffset)) {
+			plan.found         = true;
+			plan.blob          = blob;
+			plan.payloadOffset = payloadOffset;
+		}
+		return plan;
+	}
+} // namespace wolfx::stream
