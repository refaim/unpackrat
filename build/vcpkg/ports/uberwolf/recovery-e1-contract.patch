+ *  LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,
+ *  OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE
+ *  SOFTWARE.
+ *
+ */
+
+#pragma once
+
+#include "WolfRPGException.hpp"
+
+#include <cstddef>
+#include <filesystem>
+#include <functional>
+#include <string>
+#include <system_error>
+
+// Read-only source discovery factored out of WolfRPG::loadMaps / WolfRPG::loadCommonEvents. The
+// selection policy is the original one: every entry whose extension is exactly the lowercase ".mps"
+// that is a regular file, visited recursively in the filesystem iterator order, followed by the
+// single fixed "BasicData/CommonEvent.dat". The hardening over the original inline loops is that
+// only regular files are selected (a directory named "*.mps" is skipped), that reparse/symlinked
+// directories are never followed, and that a depth, visited-entry, source-count and retained-path-
+// byte budget is enforced before any source is handed to the caller. Discovery failures throw a
+// SourceDiscoveryException, which derives from WolfRPGException so the original constructors keep
+// their exact catch-and-report behaviour. VisitAll may invoke the caller's Map visitor before a
+// later CommonEvent failure is detected, and exceptions thrown by a visitor propagate to the caller
+// unchanged; VisitAll therefore never publishes a partial source list of its own, and a caller that
+// requires atomic publication stages visitor results and commits them only after VisitAll returns
+// successfully.
+namespace wolfRPGSourceDiscovery
+{
+	struct Limits
+	{
+		std::size_t maxDepth = 64U;
+		std::size_t maxVisitedEntries = 1000000U;
+		std::size_t maxSources = 100000U;
+		std::size_t maxTotalPathBytes = 64U * 1024U * 1024U;
+	};
+
+	enum class ErrorKind
+	{
+		RootMissing,
+		RootNotDirectory,
+		RootIoFailure,
+		TraversalIoFailure,
+		DepthExceeded,
+		EntryBudgetExceeded,
+		SourceBudgetExceeded,
+		PathByteBudgetExceeded,
+		CommonEventMissing,
+		CommonEventRefused,
+	};
+
+	class SourceDiscoveryException : public WolfRPGException
+	{
+	public:
+		SourceDiscoveryException(const ErrorKind& kind, const std::string& what) :
+			WolfRPGException(what),
+			m_kind(kind)
+		{
+		}
+
+		ErrorKind Kind() const noexcept
+		{
+			return m_kind;
+		}
+
+	private:
+		ErrorKind m_kind;
+	};
+
+	using SourceVisitor = std::function<void(const std::filesystem::path&)>;
+
+	// A genuine absence is reported by std::filesystem as ERROR_FILE_NOT_FOUND (2) or
+	// ERROR_PATH_NOT_FOUND (3). MSVC's generic category maps unrelated probe failures - for example an
+	// invalid name (123) - to the same std::errc::no_such_file_or_directory condition, so the raw
+	// system value is required to keep an absence distinct from a probe IO failure.
+	inline bool IsAbsent(const std::error_code& error)
+	{
+		return error.value() == 2 || error.value() == 3;
+	}
+
+	inline ErrorKind ClassifyProbeError(const std::error_code& error, const ErrorKind absent, const ErrorKind other)
+	{
+		return IsAbsent(error) ? absent : other;
+	}
+
+	// One session of discovery. The visited-entry, source and retained-path-byte counters accumulate
+	// across every Visit call on the same instance, so VisitAll charges the map walk and the common-
+	// event probe against one shared budget.
+	class SourceDiscovery
+	{
+	public:
+		explicit SourceDiscovery(const Limits& limits = Limits{}) :
+			m_limits(limits)
+		{
+		}
+
+		void VisitMapSources(const std::filesystem::path& dataFolder, const SourceVisitor& visitor)
+		{
+			std::error_code error;
+			std::filesystem::recursive_directory_iterator iterator(dataFolder, std::filesystem::directory_options::none, error);
+			if (error)
+				throw RootError(dataFolder);
+
+			const std::filesystem::recursive_directory_iterator end;
+			for (;;)
+			{
+				if (error)
+					throw SourceDiscoveryException(ErrorKind::TraversalIoFailure, "WolfRPG data folder could not be enumerated: " + dataFolder.string());
+				if (iterator == end)
+					break;
+
+				chargeEntry();
+				if (iterator.depth() > m_limits.maxDepth)
+					throw SourceDiscoveryException(ErrorKind::DepthExceeded, "WolfRPG data folder exceeds the maximum traversal depth");
+
+				const std::filesystem::directory_entry& entry = *iterator;
+				// symlink_status() never follows the entry, so a file symlink reports file_type::symlink
+				// and a directory junction reports file_type::junction instead of a regular file. Neither
+				// is ever selected, and neither may be descended into.
+				const std::filesystem::file_status linkStatus = entry.symlink_status();
+				if (std::filesystem::is_symlink(linkStatus) || linkStatus.type() == std::filesystem::file_type::junction)
+					iterator.disable_recursion_pending();
+				if (entry.path().extension() == ".mps" && std::filesystem::is_regular_file(linkStatus))
+				{
+					chargeSource(entry.path());
+					visitor(entry.path());
+				}
+				iterator.increment(error);
+			}
+		}
+
+		void VisitCommonEventSource(const std::filesystem::path& dataFolder, const SourceVisitor& visitor)
+		{
+			const std::filesystem::path basicData = dataFolder / "BasicData";
+			const std::filesystem::path source = basicData / "CommonEvent.dat";
+
+			// Any fixed path component the library appends is probed without following links, so a
+			// junctioned or symlinked BasicData cannot redirect the read outside the data folder.
+			std::error_code error;
+			const std::filesystem::file_status basicStatus = std::filesystem::symlink_status(basicData, error);
+			if (error)
+				throw SourceDiscoveryException(ClassifyProbeError(error, ErrorKind::CommonEventMissing, ErrorKind::CommonEventRefused), "WolfRPG BasicData could not be read: " + basicData.string());
+			if (!std::filesystem::is_directory(basicStatus))
+				throw SourceDiscoveryException(ErrorKind::CommonEventRefused, "WolfRPG BasicData is not a real directory: " + basicData.string());
+
+			const std::filesystem::file_status sourceStatus = std::filesystem::symlink_status(source, error);
+			if (error)
+				throw SourceDiscoveryException(ClassifyProbeError(error, ErrorKind::CommonEventMissing, ErrorKind::CommonEventRefused), "WolfRPG BasicData/CommonEvent.dat could not be read: " + source.string());
+			if (!std::filesystem::is_regular_file(sourceStatus))
+				throw SourceDiscoveryException(ErrorKind::CommonEventRefused, "WolfRPG BasicData/CommonEvent.dat is not a real regular file: " + source.string());
+
+			chargeSource(source);
+			visitor(source);
+		}
+
+		void VisitAll(const std::filesystem::path& dataFolder, const SourceVisitor& mapVisitor, const SourceVisitor& commonEventVisitor)
+		{
+			VisitMapSources(dataFolder, mapVisitor);
+			VisitCommonEventSource(dataFolder, commonEventVisitor);
+		}
+
+	private:
+		SourceDiscoveryException RootError(const std::filesystem::path& dataFolder) const
+		{
+			std::error_code error;
+			const std::filesystem::file_status status = std::filesystem::status(dataFolder, error);
+			if (error)
+				return SourceDiscoveryException(ClassifyProbeError(error, ErrorKind::RootMissing, ErrorKind::RootIoFailure), "WolfRPG data folder could not be read: " + dataFolder.string());
+			if (!std::filesystem::is_directory(status))
+				return SourceDiscoveryException(ErrorKind::RootNotDirectory, "WolfRPG data folder is not a real directory: " + dataFolder.string());
+			return SourceDiscoveryException(ErrorKind::TraversalIoFailure, "WolfRPG data folder could not be enumerated: " + dataFolder.string());
+		}
+
+		void chargeEntry()
+		{
+			if (m_visitedEntries == m_limits.maxVisitedEntries)
+				throw SourceDiscoveryException(ErrorKind::EntryBudgetExceeded, "WolfRPG data folder exceeds the visited-entry budget");
+			++m_visitedEntries;
+		}
+
+		void chargeSource(const std::filesystem::path& source)
+		{
+			if (m_sources == m_limits.maxSources)
+				throw SourceDiscoveryException(ErrorKind::SourceBudgetExceeded, "WolfRPG data folder exceeds the source budget");
+			const std::size_t bytes = source.native().size() * sizeof(std::filesystem::path::value_type);
+			if (bytes > m_limits.maxTotalPathBytes - m_pathBytes)
+				throw SourceDiscoveryException(ErrorKind::PathByteBudgetExceeded, "WolfRPG data folder exceeds the retained-path-byte budget");
+			++m_sources;
+			m_pathBytes += bytes;
+		}
+
+	private:
+		Limits m_limits;
+		std::size_t m_visitedEntries = 0;
+		std::size_t m_sources = 0;
+		std::size_t m_pathBytes = 0;
+	};
+} // namespace wolfRPGSourceDiscovery
