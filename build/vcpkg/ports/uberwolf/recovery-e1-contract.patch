+++ b/UberWolfLib/WolfCrypt/ModernContext.hpp
@@ -0,0 +1,79 @@
+/*
+ *  File: ModernContext.hpp
+ *
+ *  Operation-local entry points for the "new crypt" Wolf RPG DX archive container
+ *  (the full modern range: 331..999 and 1010..65535). They are thin adapters over the RNG-parameterized
+ *  derivations in WolfCrypt.hpp: the same derivation bodies the legacy initWolfCrypt /
+ *  cryptAddresses / DXArchive body-size sequence use, driven here by an operation-local
+ *  rng::MsvcLcg instead of the process-global CRT stream. Nothing here re-implements a
+ *  derivation; it only injects the owned RNG and adapts the caller-facing signatures used
+ *  by the unpackrat Wolf RPG adapter.
+ *
+ *  The AES-CTR counter step and the seekable range transform are not re-implemented here
+ *  either: they live once in WolfAes.hpp as wolf::crypt::aes::addCounter / aesCtrXCryptRange
+ *  and are reached through the same helpers the sequential aesCtrXCrypt entry point uses.
+ *
+ *  Vendor-only header: it is included from adapter implementation translation units and is
+ *  not part of the public unpackrat API.
+ */
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+
+#include "WolfCrypt.hpp"
+
+namespace wolf::crypt::modern
+{
+inline constexpr std::size_t KEY_SIZE = 768;
+
+// deriveWolfKeyWithRandom driven by an operation-local LCG. ``other`` selects the outer key
+// (true, salted from the NUL-terminated pKeyString unless cryptVersion == 0x15E) or the inner
+// key (false). ``pKey2`` is the optional Pro rekey blob read by the >= 1010 derivations; it is
+// null for the outer key and by default, so the original call shape stays unchanged. The
+// archive-body XOR is a separate step and is not run here.
+inline void initWolfCrypt(const uint8_t *pReserve, const bool &other, const uint16_t &cryptVersion,
+                          const char *pKeyString, uint8_t *pKey, uint8_t *pKey2 = nullptr)
+{
+	rng::MsvcLcg rng;
+	deriveWolfKeyWithRandom(cryptVersion, pReserve, pKey, pKey2, rng, pKeyString, other);
+}
+
+// cryptAddressesWithRandom driven by an operation-local LCG.
+inline void cryptAddresses(uint8_t *pHeader, const uint8_t *pReserve, const uint16_t &cryptVersion)
+{
+	rng::MsvcLcg rng;
+	cryptAddressesWithRandom(pHeader, pReserve, static_cast<uint32_t>(cryptVersion), rng);
+}
+
+// The v3.50 body size, drawn over the shared helper with the full 64-bit ``physicalSize - 64``
+// candidate. The result is narrowed to 32 bits exactly as the packed header field expects.
+// ``pK2`` is the optional Pro rekey blob folded into the >= 1020 seed by the shared helper and
+// is null otherwise.
+inline uint32_t bodySize(const uint8_t *pReserve, const uint64_t &physicalSize, const uint16_t &cryptVersion,
+                         const uint8_t *pK2 = nullptr)
+{
+	uint32_t xorshiftState = 0;
+
+	return static_cast<uint32_t>(drawArchiveBodySize(archiveBodySeed(pK2, pReserve, cryptVersion),
+	                                                 static_cast<int64_t>(physicalSize), physicalSize - 64, xorshiftState));
+}
+
+// Operation-local runRngChain: the shared WolfRng.hpp chain driven by an owned rng::MsvcLcg
+// instead of the process-global CRT stream, so a caller's derivation never perturbs rand().
+inline void runRngChain(rng::RngData &rd, const uint32_t &seed1, const uint32_t &seed2)
+{
+	rng::MsvcLcg ownedRng;
+
+	rng::runRngChain(rd, seed1, seed2, ownedRng);
+}
+
+// Operation-local aesKeyGen: the shared WolfCrypt.hpp schedule (chain + Fisher-Yates shuffle)
+// driven by an owned rng::MsvcLcg, sharing every recurrence with the legacy CrtRng entry point.
+inline void aesKeyGen(CryptData &cd, rng::RngData &rd, aes::AesKey &aesKey, aes::AesIV &aesIv)
+{
+	rng::MsvcLcg ownedRng;
+
+	aesKeyGenWithRandom(cd, rd, aesKey, aesIv, ownedRng);
+}
+} // namespace wolf::crypt::modern
