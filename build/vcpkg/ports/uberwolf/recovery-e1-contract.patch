+
+#pragma once
+
+#include "Types.h"
+
+// Game data and companion localization, extracted from the original UberWolfLib discovery so the
+// library, the CLI front-end and any embedding application share one policy instead of three
+// copies:
+//
+//   * the game executable is Game.exe, then GamePro.exe, searched in the archive's parent folder
+//     (or that folder's parent when the folder is named exactly "Data");
+//   * the data root is the first data.<extension> beside the executable -- the data then lives in
+//     the game folder itself -- otherwise an existing "Data" directory;
+//   * the DxArc companion is the first existing entry of GetSpecialFiles() in the data root,
+//     name-major and then extension-major.
+//
+// The executable, special-file and extension tables keep their single owners (here for the
+// executables, WolfUtils for the special files and extensions), and every comparison is the
+// original case-sensitive one. Nothing in this module writes a file, starts a process or changes
+// the working directory; the only filesystem access is a read-only existence probe.
+namespace wolf::game
+{
+	enum class ContextStatus
+	{
+		Resolved = 0,     // executable, data root and companion all located
+		MissingContext,   // no game executable, or no data root beside it
+		MissingCompanion, // data root located but no pinned companion file
+		IoFailure,        // a probe failed instead of reporting a simple absence
+	};
+
+	struct Context
+	{
+		tString executablePath;
+		tString gameFolder;
+		tString dataFolder;
+		tString companionFile;
+		bool dataInBaseFolder   = false;
+		ContextStatus status    = ContextStatus::MissingContext;
+	};
+
+	// The executable names the original findGameFromArchive searched, in precedence order.
+	const tStrings& GameExecutableNames();
+
+	// The name of the data folder the executable sits beside.
+	const tString& DataFolderName();
+
+	// The folder the executable search starts in for an archive at ``archivePath``.
+	tString ExecutableSearchFolder(const tString& archivePath);
+
+	// The first existing candidate in ``searchFolder`` (Game.exe then GamePro.exe), or an empty
+	// string.
+	tString FindGameExecutable(const tString& searchFolder);
+
+	// The original findDataFolder policy: fills ``dataFolder`` and ``dataInBaseFolder`` and returns
+	// false when neither a data.<extension> file nor a Data directory exists beside the executable.
+	bool FindDataFolder(const tString& gameFolder, tString& dataFolder, bool& dataInBaseFolder);
+
+	// The original WolfPro companion policy: the first existing special file in ``dataFolder``, or
+	// an empty string.
+	tString FindCompanionFile(const tString& dataFolder);
+
+	// The full, side-effect-free resolution from a game executable path. A path without a parent is
+	// made absolute against the current directory exactly as InitGame did.
+	Context ResolveFromExecutable(const tString& executablePath);
+
+	// The full, side-effect-free resolution from an archive path.
+	Context ResolveFromArchive(const tString& archivePath);
+}
