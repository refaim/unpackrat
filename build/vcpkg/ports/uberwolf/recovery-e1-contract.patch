+// unpackrat port patch: the original DX6 entry points drive the shared DX1..DX6 kernel
+// (dxarc_legacy, DXArchiveVer5.h) through these adapters, so the header layout and the metadata
+// transform are decoded by the single implementation the unpackrat adapter uses as well.
+namespace
+{
+	// Whole physical length of an open stream, or -1 when the stream cannot be measured. The end
+	// seek is the single length probe the classic entry points used; a stream that refuses it (a
+	// console, for example) is rejected by the caller's lower bound. No rewind is needed because
+	// every caller positions the stream explicitly before its next read.
+	s64 Dx6StreamLength( FILE *fp )
+	{
+		if( _fseeki64( fp, 0, SEEK_END ) != 0 )
+			return -1 ;
+		return _ftelli64( fp ) ;
+	}
+
+	// Exact-count classification of a positioned read. A read is complete only when the delivered
+	// byte count equals the requested count; the comparison stays at size_t width so a shortfall
+	// wider than INT_MAX (a 4 GiB gap in a large whole-image read, say) cannot narrow into a false
+	// completion the way an ``(int)( want - got )`` test would.
+	int Dx6ExactReadResult( size_t want, size_t got )
+	{
+		return got == want ? 0 : -1 ;
+	}
+
+	// Positions ``fp`` at ``Offset`` and copies exactly ``Size`` bytes. A refused seek is reported
+	// on its own and short-circuits before the read, so a stream that cannot be positioned is never
+	// consumed (the bytes a queued stream still holds stay unread). A completed read is one whose
+	// delivered count equals the request exactly.
+	int Dx6ReadAt( FILE *fp, s64 offset, void *dest, s64 size )
+	{
+		if( _fseeki64( fp, offset, SEEK_SET ) != 0 )
+			return -1 ;
+		const size_t want = (size_t)size ;
+		const size_t got = fread( dest, 1, want, fp ) ;
+		return Dx6ExactReadResult( want, got ) ;
+	}
