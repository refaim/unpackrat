index 1edbeb0..d784b95 100644
--- a/UberWolfLib/WolfCrypt/WolfChaCha20.hpp
+++ b/UberWolfLib/WolfCrypt/WolfChaCha20.hpp
@@ -114,18 +114,33 @@ inline void blockNext(uint32_t *pState, uint32_t *pKeyStream)
 		counter[1]++;
 }
 
-// Slightly modified version of the default functionality
-// - Counter is initialized to (1 + startPos / 64)
-// - The number of steps done can vary at the beginning or end of the function, depending on startPos
-//   - For startPos % 64 != 0, the first block will not process 64 bit
-//   - For length % 64 != 0, the last block will not process 64 bit
-inline void execute(uint32_t *pState, uint32_t *pKeyStream, const uint32_t &startPos, uint8_t *bytes, const uint64_t &length)
+// Advances the block counter to the block that holds stream position ``position``. The counter is
+// the 64-bit value state[13]:state[12], so a seek past 2^32 keeps its high word instead of silently
+// truncating to 32 bits. Used by applyCallRange for a whole-call-relative offset.
+inline void seekToPosition(uint32_t *pState, const uint64_t &position)
+{
+	uint64_t counter = (static_cast<uint64_t>(pState[13]) << 32) | pState[12];
+	counter += position / 64;
+	pState[12] = static_cast<uint32_t>(counter);
+	pState[13] = static_cast<uint32_t>(counter >> 32);
+}
+
+// The original execute() block seek: a plain 32-bit add to the low counter word. It deliberately
+// does NOT carry a wrap into state[13], so an already advanced counter whose low word wraps keeps
+// the original block for the first step. Kept verbatim so execute()'s long-standing behaviour is
+// unchanged for callers that hand it a preset state; applyCallRange uses seekToPosition instead.
+inline void seekBlocks(uint32_t *pState, const uint32_t &blockCount)
+{
+	pState[12] += blockCount;
+}
+
+// Runs the original block loop over ``length`` bytes starting ``offset`` bytes into a block. Only
+// the bytes the slice covers are visited; the state advances through the intervening blocks.
+inline void xorStream(uint32_t *pState, uint32_t *pKeyStream, uint64_t offset, uint8_t *bytes,
