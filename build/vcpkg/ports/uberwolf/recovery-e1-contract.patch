+			Frame Current = Stack.back();
+			Stack.pop_back();
+
+			if( !KernelWithin( (u64)Current.DirOffset, DirectoryRecord, HeadSize ) )
+				return -1;
+
+			{
+				u64 DirBase         = (u64)Current.DirOffset;
+				u64 SelfAddress     = KernelWord( Meta + DirBase, Wide );
+				u64 ParentAddress   = KernelWord( Meta + DirBase + ( Wide ? 8 : 4 ), Wide );
+				u64 FileHeadNum     = KernelWord( Meta + DirBase + ( Wide ? 16 : 8 ), Wide );
+				u64 FileHeadAddress = KernelWord( Meta + DirBase + ( Wide ? 24 : 12 ), Wide );
+				u64 Index;
+
+				// A directory record names its own DARC_FILEHEAD and its real ancestor, because the
+				// classic navigation reads both links as table offsets. The root record carries no
+				// file head, so its self marker is the none sentinel (or the classic encoder's
+				// zero) and its parent marker is always the none sentinel.
+				if( Current.ParentOffset < 0 )
+				{
+					if( ParentAddress != DirSentinel )
+						return -1;
+					if( SelfAddress != 0 && SelfAddress != DirSentinel )
+						return -1;
+				}
+				else
+				{
+					if( SelfAddress % FileRecord != 0 )
+						return -1;
+					// The relative self offset must itself lie inside the file table before the
+					// table base is added: a raw 64-bit value that overflows FileTable + SelfAddress
+					// would otherwise pass the range test while pointing at unrelated metadata.
+					if( !KernelWithin( FileTable, SelfAddress, DirTable ) ||
+						!KernelWithin( FileTable + SelfAddress, FileRecord, DirTable ) )
+						return -1;
+					// The parent link must be exactly this record's ancestor, so a wrong-but-in-range
+					// or self-cycling parent cannot steer navigation to an unrelated directory.
+					if( ParentAddress != (u64)Current.ParentOffset )
+						return -1;
+					// The named file head must point back at this exact directory record.
+					if( KernelWord( Meta + FileTable + SelfAddress + ( Wide ? 40 : 32 ), Wide ) != DirBase - DirTable )
+						return -1;
+					if( ( KernelWord( Meta + FileTable + SelfAddress + ( Wide ? 8 : 4 ), Wide ) & 0x10u ) == 0 )
+						return -1;
+				}
+
+				if( FileHeadNum > KernelMaxEntries )
+					return -1;
+				if( ( FileHeadAddress % FileRecord ) != 0 )
+					return -1;
+				if( FileHeadAddress > DirTable - FileTable )
+					return -1;
+				if( FileHeadNum * FileRecord > ( DirTable - FileTable ) - FileHeadAddress )
+					return -1;
+
+				for( Index = 0; Index < FileHeadNum; Index ++ )
+				{
+					u64 Base          = FileTable + FileHeadAddress + Index * FileRecord;
+					u64 NameAddress   = KernelWord( Meta + Base, Wide );
+					u64 Attributes    = KernelWord( Meta + Base + ( Wide ? 8 : 4 ), Wide );
+					u64 DataAddress   = KernelWord( Meta + Base + ( Wide ? 40 : 32 ), Wide );
+					u64 DataSize      = KernelWord( Meta + Base + ( Wide ? 48 : 36 ), Wide );
+					u64 Press         = PressSentinel;
+					u64 Stored;
+					int NameLen, IsDirectory;
+
+					NameLen = KernelName( Meta, NameAddress, FileTable, NameBuf, KernelMaxPathBytes );
+					if( NameLen < 0 )
+						return -1;
+					if( !KernelNameValid( NameBuf, NameLen ) )
+						return -1;
+
+					Produced ++;
+					if( Produced > KernelMaxEntries )
+						return -1;
+
+					IsDirectory = ( Attributes & 0x10 ) != 0;
+					if( IsDirectory )
+					{
+						if( Current.Depth + 1 > KernelMaxDepth )
+							return -1;
+						if( DataAddress == 0 )
+							return -1;
+						if( ( DataAddress % DirectoryRecord ) != 0 )
+							return -1;
+						if( !KernelWithin( DirTable, DataAddress, HeadSize ) )
+							return -1;
+						if( DirectoryRecord > HeadSize - ( DirTable + DataAddress ) )
+							return -1;
+						if( (u64)Current.Prefix.size() + (u64)NameLen + 1 > KernelMaxPathBytes )
+							return -1;
+						{
+							Frame Child;
+							Child.DirOffset = (s64)( DirTable + DataAddress );
+							Child.ParentOffset = Current.DirOffset - (s64)DirTable;
+							Child.Depth     = Current.Depth + 1;
+							Child.Prefix    = Current.Prefix;
+							Child.Prefix.append( (const char *)NameBuf, (size_t)NameLen );
+							Child.Prefix.push_back( '/' );
+							Stack.push_back( Child );
+						}
+						continue;
+					}
+
+					if( Wide )
+						Press = KernelWord( Meta + Base + 56, 1 );
+					else if( Head->Version >= 2 )
+						Press = KernelWord( Meta + Base + 40, 0 );
+					Stored = Press == PressSentinel ? DataSize : Press;
+
+					if( DataAddress > (u64)Head->NameTable - (u64)Head->DataStart )
+						return -1;
+					{
+						u64 Offset    = (u64)Head->DataStart + DataAddress;
+						u64 NameTable = (u64)Head->NameTable;
+						if( Offset > NameTable )
+							return -1;
+						if( Stored > NameTable - Offset )
+							return -1;
+					}
+					if( DataSize > (u64)0x7fffffffffffffffull )
+						return -1;
+					if( (u64)Current.Prefix.size() + (u64)NameLen > KernelMaxPathBytes )
+						return -1;
+
+					{
+						std::string Raw = Current.Prefix;
+						Raw.append( (const char *)NameBuf, (size_t)NameLen );
+						if( Sink->OnRecord( Sink->User, (const unsigned char *)Raw.data(), (int)Raw.size(),
+						                    (int)Current.Depth, 0, (unsigned int)Attributes,
+						                    (s64)DataAddress, (s64)DataSize, (s64)Press ) != 0 )
+							return -1;
+					}
+				}
+			}
+		}
+		return 0;
+	}
+
+	// Reads up to ``Want`` decrypted stored bytes at ``PhysicalOffset + *Cursor`` and advances the
+	// cursor, so a caller streams the body in bounded chunks instead of materialising it.
+	inline int KernelReadStored( const KernelSource *Src, const KernelKey *Key, const unsigned char *Secret,
+	                             s64 PhaseBase, s64 PhysicalOffset, s64 Stored, s64 *Cursor,
+	                             unsigned char *Dest, int Want )
+	{
+		unsigned char SecretCopy[ KernelKeyBytes ];
+		s64 Remaining, Chunk;
+		if( Src == NULL || Key == NULL || Key->Conv == NULL || Secret == NULL || Cursor == NULL || Stored < 0 )
+			return -1;
+		if( Want < 0 )
+			return -1;
+		Remaining = Stored - *Cursor;
+		if( Remaining <= 0 )
+			return 0;
+		Chunk = Remaining < (s64)Want ? Remaining : (s64)Want;
+		if( Chunk <= 0 )
+			return 0;
+		if( Src->Read( Src->User, PhysicalOffset + *Cursor, Dest, (int)Chunk ) != 0 )
+			return -1;
+		memcpy( SecretCopy, Secret, KernelKeyBytes );
+		Key->Conv( Dest, (int)Chunk, (int)( ( PhaseBase + *Cursor ) % KernelKeyBytes ), SecretCopy );
+		*Cursor += Chunk;
+		return (int)Chunk;
+	}
+} // namespace dxarc_legacy
+
+#endif // DXARC_LEGACY_KERNEL_H
+
 #endif
 
