-inline void aesCtrXCrypt(uint8_t *pData, uint8_t *pKey, const std::size_t &size)
+// Big-endian modular add of ``addend`` to a 16-byte AES counter. It is the single counter step
+// shared by the sequential CTR loop below and the seekable range helper: a byte that overflows
+// resets to zero and carries into the next, and a carry out of the most significant byte is
+// discarded, so a saturated counter wraps to all zeros exactly like the original loop did.
+inline void addCounter(uint8_t *pCounter, const std::uint64_t &addend) noexcept
+{
+	std::uint64_t carry = addend;
+
+	for (std::int32_t b = BLOCKLEN - 1; b >= 0 && carry != 0; b--)
+	{
+		const std::uint64_t sum = static_cast<std::uint64_t>(pCounter[b]) + (carry & 0xFFu);
+
+		pCounter[b] = static_cast<uint8_t>(sum & 0xFFu);
+		carry       = (carry >> 8) + (sum >> 8);
+	}
+}
+
+// AES_CTR_xcrypt over one contiguous range with the UberWolf nonstandard key schedule.
+// ``pRoundKey`` is the already expanded KEY_EXP_SIZE round key, ``pIv`` is the 16-byte counter
+// origin (advanced in place by one step per generated block, exactly like aesCtrXCrypt at a
+// zero offset) and ``offset`` is the byte distance of the first output byte from that origin.
+// The block that owns ``offset`` is generated up front and its leading ``offset % BLOCKLEN``
+// bytes are discarded without being emitted, so a caller can transform an unaligned seekable
+// range. An empty range is a true no-op and leaves ``pIv`` untouched.
+inline void aesCtrXCryptRange(uint8_t *pData, const uint8_t *pRoundKey, uint8_t *pIv, const std::uint64_t &offset, const std::size_t &size)
 {
+	if (size == 0)
+		return;
+
+	addCounter(pIv, offset / BLOCKLEN);
+
 	uint8_t state[BLOCKLEN];
-	uint8_t *pIv = pKey + KEY_EXP_SIZE;
-	int32_t bi   = BLOCKLEN;
+
+	std::memcpy(state, pIv, BLOCKLEN);
+
+	cipher(state, pRoundKey);
+
+	addCounter(pIv, 1);
+
+	std::size_t bi = static_cast<std::size_t>(offset % BLOCKLEN);
 
 	for (std::size_t i = 0; i < size; i++, bi++)
 	{
@@ -269,18 +303,9 @@ inline void aesCtrXCrypt(uint8_t *pData, uint8_t *pKey, const std::size_t &size)
 		{
 			std::memcpy(state, pIv, BLOCKLEN);
 
-			cipher(state, pKey);
-
-			for (bi = BLOCKLEN - 1; bi >= 0; bi--)
-			{
-				if (pIv[bi] == 0xFF)
-				{
-					pIv[bi] = 0;
-					continue;
-				}
-				pIv[bi]++;
-				break;
-			}
+			cipher(state, pRoundKey);
+
+			addCounter(pIv, 1);
 			bi = 0;
 		}
 
@@ -288,7 +313,16 @@ inline void aesCtrXCrypt(uint8_t *pData, uint8_t *pKey, const std::size_t &size)
 	}
 }
 
+// AES_CTR_xcrypt -- the original sequential entry point, now a zero-offset delegation to the
+// shared range helper. It keeps its exact advanced-IV side effect: ``pKey + KEY_EXP_SIZE`` is
+// incremented once per generated block (ceil(size / BLOCKLEN) for a non-empty range) and is
+// left untouched for an empty range.
+inline void aesCtrXCrypt(uint8_t *pData, uint8_t *pKey, const std::size_t &size)
+{
+	aesCtrXCryptRange(pData, pKey, pKey + KEY_EXP_SIZE, 0, size);
+}
+
 ////// AES CTR Crypt
 /////////////////////////////////
 
-} // namespace wolf::crypt::aes
\ No newline at end of file
+} // namespace wolf::crypt::aes
